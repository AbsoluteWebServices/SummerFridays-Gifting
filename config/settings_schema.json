        "label": "Login"
      },
      {
        "type": "image_picker",
        "id": "account_image_activate",
        "label": "Activate"
      },
      {
        "type": "image_picker",
        "id": "account_image_register",
        "label": "Register"
      },
      {
        "type": "image_picker",
        "id": "account_image_reset_password",
        "label": "Reset Password"
      },
      {
        "type": "header",
        "content": "Subscriptions"
      },
      {
        "type": "checkbox",
        "id": "acc_subs_custom_message_enable",
        "label": "Enable custom message",
        "default": true
      },
      {
        "type": "richtext",
        "id": "acc_subs_custom_message",
        "label": "Custom message"
      },
      {
        "type": "header",
        "content": "No Subscriptions Products"
      },
      {
        "type": "richtext",
        "id": "acc_subs_content",
        "label": "Content",
        "info": "Hint: use Heading 2 for title, and paragraph for body",
