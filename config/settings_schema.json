      },
      {
        "id": "acc_subs_limit",
        "label": "Limit",
        "type": "range",
        "info": "Recommended amount: 6-10",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 8
      },
      {
        "type": "product_list",
        "id": "acc_subs_products",
        "label": "Products",
        "limit": 10
      }
    ]
  },
