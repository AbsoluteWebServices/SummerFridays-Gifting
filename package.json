{
  "name": "shopify-theme-adastra-vite",
  "version": "1.0.0",
  "description": "Shopify theme | Adastra, Vite",
  "repository": "https://github.com/AbsoluteWebServices/SummerFridays",
  "author": "Absolute Web",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.4"
  },
  "scripts": {
    "dev": "adastra dev --live-reload=off --store=summerfridaysbeauty.myshopify.com",
    "build": "adastra build",
    "deploy": "shopify theme push --ignore assets/adastra.manifest.json --ignore config/*_data.json --ignore templates/*json --ignore templates/customers/*.json --ignore package.json --ignore package-lock.json --ignore jsconfig.* --ignore tsconfig.* --ignore ./*.config.* --ignore src/ --ignore misc/ --ignore node_modules --store=summerfridaysbeauty.myshopify.com"
  },
  "dependencies": {
    "@alpinejs/focus": "^3.13.7",
    "@alpinejs/intersect": "^3.13.7",
    "@klevu/core": "^3.6.0",
    "@shopify/theme-currency": "^4.1.1",
    "alpinejs": "^3.14.6",
    "body-scroll-lock-upgrade": "^1.1.0",
    "eslint": "^7.18.0",
    "eslint-config-prettier": "^7.1.0",
    "hoverintent": "^2.2.1",
    "js-cookie": "^3.0.5",
    "postcss-preset-env": "^6.7.0",
    "swiper": "^11.1.15"
  },
  "devDependencies": {
    "@shopify/cli": "^3.72.1",
    "@shopify/theme": "^3.58.2",
    "@vitejs/plugin-react": "^3.1.0",
    "adastra-cli": "latest",
    "adastra-plugin": "latest",
    "adastra-prettier-config": "^0.1.4",
    "autoprefixer": "^10.4.14",
    "glob": "^10.2.6",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "sass": "~1.50",
    "vite": "^6.0.2",
    "vite-plugin-css-export": "^3.0.0",
    "vite-svg-sprite-wrapper": "^1.3.0"
  },
  "resolutions": {
    "@oclif/core": "2.1.4"
  }
}
