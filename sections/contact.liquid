{%- liquid
    assign padding_top = section.settings.padding_top | default: 0
    assign padding_bottom = section.settings.padding_bottom | default: 0
    assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
    assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

    assign media_type = section.settings.media_type | default: 'image'
    assign lazyload = section.settings.lazyload | default: false
    assign image = section.settings.image
    assign video = section.settings.video
    assign content = section.settings.content | default: '<h1>Contact Us</h1>'
    assign show_social_links = section.settings.show_social_links | default: false
    assign menu = section.settings.menu
    assign loading = 'eager'
    if lazyload == true
        assign loading = 'lazy'
    endif
-%}

{%- render 'offset',
    id: section.id,
    padding_top: padding_top,
    padding_bottom: padding_bottom,
    padding_top_desktop: padding_top_desktop,
    padding_bottom_desktop: padding_bottom_desktop
-%}

{%- render 'adastra' with 'styles/sections/contact.scss' -%}

<section id='section-{{- section.id -}}'>
    <div class='container container--smaller-tablet container--padding-tablet'>
        <div class='two-cols-wrapper'>
            <div class='media-col'>
                {%- if media_type == 'image' -%}
                    {%- if image -%}
                        {%- render 'img', image: image, loading: loading -%}
                    {%- endif -%}
                {%- elsif media_type == 'video' -%}
                    {%- if video -%}
                        {%- render 'video', video: video, poster: image -%}
                    {%- endif -%}
                {%- endif -%}
            </div>

            <div class='content-col'>
                <div class='rte'>
                    {{- content -}}
                </div>

				{%- if section.blocks.size > 0 -%}
					<div class="contact__info-items">
						{%- for block in section.blocks -%}
							{%- liquid 
								assign title = block.settings.title | escape | strip_html
								assign link_title = block.settings.link_title | escape | strip_html
								assign link_url = block.settings.link_url
								if title == blank
									continue
								endif
							-%}
							<div class="contact__info-item">
								<div class="p-large contact__info-item-title">{{- title -}}</div>

								{%- if link_title != blank and link_url != blank -%}
									<a href="{{- link_url -}}" aria-label="{{- link_title -}}" class="contact__info-item-link hover-arrow hover-opacity cta-textlink">
										{{- link_title -}}
										{%- render 'icon', name: 'arrow-right' -%}
									</a>
								{%- endif -%}
							</div>
						{%- endfor -%}
					</div>
				{%- endif -%}

				{%- if show_social_links -%}
					{%- render 'social-links', classes: 'contact__social-links' -%}
				{%- endif -%}

				{%- if menu != blank -%}
                    {%- assign links = linklists[menu].links -%}
                    {%- if links.size > 0 -%}
                        <ul class="contact__links list-reset a-underline-wrapper a-underline-style-2">
                            {%- for link in links -%}
                                <li class="contact__link">
                                    <a href="{{- link.url -}}" aria-label="{{- link.title -}}">{{- link.title -}}</a>
                                </li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}
                {%- endif -%}
            </div>
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Contact | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Settings"
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "Media type",
            "default": "video",
            "options": [
                {
                    "value": "image",
                    "label": "Image"
                },
                {
                    "value": "video",
                    "label": "Video"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "lazyload",
            "label": "Lazyload",
            "default": false,
            "info": "Enable if the media is below the fold."
        },
        {
            "type": "video",
            "id": "video",
            "label": "Video",
            "info": "Format: .mp4"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "With the video type, the image is used as a poster (first frame)"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        },
        {
            "type": "checkbox",
            "id": "show_social_links",
            "label": "Show social links",
            "default": true
        },
        {
            "type": "link_list",
            "id": "menu",
            "label": "Menu"
        }
    ],
    "blocks": [
        {
            "type": "info",
            "name": "Info",
            "settings": [
                {
                    "id": "title",
                    "label": "Title",
                    "type": "text"
                },
                {
                    "id": "link_title",
                    "label": "Link title",
                    "type": "text"
                },
                {
                    "id": "link_url",
                    "label": "Link URL",
                    "type": "url"
                }
            ]
        }
    ]
}
{% endschema %}
