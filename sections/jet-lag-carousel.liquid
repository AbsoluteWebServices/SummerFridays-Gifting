{%- if section.blocks.size > 0 -%}
    {%- liquid
        assign title_top = section.settings.title_top | escape | strip_html
        assign title = section.settings.title | replace: '®', '<sup>®</sup>' | replace: '™', '<sup>™</sup>'
        assign active_slide = 1

        assign media_type = section.settings.media_type | default: 'video'
        assign video_desktop = section.settings.video_desktop
        assign video_mobile = section.settings.video_mobile | default: video_desktop
        assign image_desktop = section.settings.image_desktop
        assign image_mobile = section.settings.image_mobile | default: image_desktop
        assign bg_color = section.settings.bg_color | default: 'white'

        assign hide_variant_selectors = section.settings.hide_variant_selectors | default: false

        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/jet-lag-carousel.scss' -%}

    <section id="section-{{- section.id -}}" x-data="jetLagCarousel({{- active_slide -}})" x-intersect.once="initSlider()" data-split-load-section>
        <div class="jet-lag-carousel" style="background-color: var(--{{- bg_color -}});">
            <div class="jet-lag-carousel__media">
                {%- if media_type == 'image' -%}
                    {%- render 'picture',
                        image_desktop: image_desktop,
                        image_mobile: image_mobile,
                        loading: 'eager'
                    -%}
                {%- elsif media_type == 'video' -%}
                    {%- render 'video',
                        video: video_mobile,
                        poster: image_mobile,
                        play_control: true,
                        wrapper_class: 'jet-lag-carousel__video-wrapper--mobile'
                    -%}
                    {%- render 'video',
                        video: video_desktop,
                        poster: image_desktop,
                        play_control: true,
                        wrapper_class: 'jet-lag-carousel__video-wrapper--desktop'
                    -%}
                {%- endif -%}
            </div>
            <div class="jet-lag-carousel__container">
                {%- if title_top != blank -%}
                    <div class="jet-lag-carousel__title-top subheader-large">{{- title_top -}}</div>
                {%- endif -%}

                {%- if title != blank -%}
                    <div class="rte jet-lag-carousel__title">{{- title -}}</div>
                {%- endif -%}

                <div class="jet-lag-carousel__slider swiper" x-ref="slider">
                    <div class="swiper-wrapper">
                        {%- for block in section.blocks -%}
                            {%- assign product = block.settings.product -%}

                            {%- if product != blank -%}
                                {%- liquid
                                    assign product_title = product.title
                                    assign product_image = product.metafields.custom.transparent_background_image.value | default: product.featured_image

                                    if product.metafields.accentuate.plp_title != blank
                                        assign product_title = product.metafields.accentuate.plp_title | escape
                                    endif
                                -%}

                                <div class="jet-lag-carousel__slide jet-lag-carousel__slide--{{ forloop.index }} swiper-slide">
                                    <a 
                                        href="{{- product.url -}}"
                                        class="jet-lag-carousel__image-wrapper"
                                        aria-label="Go to {{ product_title }}"
                                        {% if product_image %}
                                            style="aspect-ratio: {{ product_image.aspect_ratio }};"
                                        {% endif %}
                                    >
                                        {%- if product_image != blank -%}
                                            {%- render 'img', image: product_image -%}
                                        {%- endif -%}
                                    </a>
                                </div>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                </div>

                <div class="jet-lag-carousel__contents">
                    {%- for block in section.blocks -%}
                        {%- liquid
                            assign product = block.settings.product
                            assign product_title = product.title
                            assign product_subtitle = product.metafields.accentuate.product_type | escape | default: ''

                            if product.metafields.accentuate.plp_title != blank
                                assign product_title = product.metafields.accentuate.plp_title | escape
                            endif

                            assign product_title_html = product_title | replace: '®', '<sup>®</sup>' | replace: '™', '<sup>™</sup>'
                        -%}

                        <div class="jet-lag-carousel__content jet-lag-carousel__content--{{ forloop.index }}{% if active_slide == forloop.index0 %} jet-lag-carousel__content--initial{% endif %}">
                            <div>
                                <h3 class="jet-lag-carousel__subtitle">
                                    <a 
                                        href="{{- product.url -}}"
                                        class="hover-opacity"
                                        aria-label="Go to {{ product_title }}"
                                    >
                                        {{- product_title_html -}}
                                    </a>
                                </h3>

                                <div class="jet-lag-carousel__description"
                                    {% if product_subtitle == blank %}
                                        style="display: none;"
                                    {% endif %}>
                                    {{- product_subtitle -}}
                                </div>
                            </div>

                            {%- render 'product-card-small',
                                product: product,
                                lazyload: true,
                                inHiddenOverflow: false,
                                style: 2,
                                top: true,
                                hide_variant_selectors: hide_variant_selectors
                            -%}
                        </div>
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </section>

    {%- style -%}
        {%- for block in section.blocks -%}
            .jet-lag-carousel:has(.swiper-initialized):has(.jet-lag-carousel__slide--{{- forloop.index -}}.swiper-slide-active) .jet-lag-carousel__content--{{- forloop.index -}} {
                display: flex;
            }

            @media screen and (min-width: 1280px) {
                .jet-lag-carousel:has(.swiper-initialized):has(.jet-lag-carousel__slide--{{- forloop.index -}}.swiper-slide-active) .jet-lag-carousel__content--{{- forloop.index -}} {
                    opacity: 1;
                }
            }
        {%- endfor -%}
    {%- endstyle -%}
{%- endif -%}

{% schema %}
{
    "name": "Jet Lag Carousel | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Media Settings"
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "Media type",
            "default": "video",
            "options": [
                { "value": "image", "label": "Image" },
                { "value": "video", "label": "Video" }
            ]
        },
        {
            "type": "video",
            "id": "video_desktop",
            "label": "Video desktop",
            "info": "Format: .mp4"
        },
        {
            "type": "video",
            "id": "video_mobile",
            "label": "Video mobile",
            "info": "Format: .mp4; If not uploaded, defaults to the desktop video"
        },
        {
            "type": "image_picker",
            "id": "image_desktop",
            "label": "Desktop image",
            "info": "With the video type, the image is used as a poster (first frame)"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Mobile image",
            "info": "With the video type, the image is used as a poster (first frame). If not uploaded, defaults to the desktop image"
        },
        {
            "type": "select",
            "id": "bg_color",
            "label": "Background color",
            "default": "white",
            "options": [
                { "value": "white", "label": "White" },
                { "value": "chalk", "label": "Chalk" },
                { "value": "morning-sky", "label": "Morning Sky" }
            ]
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "text",
            "id": "title_top",
            "label": "Title (top)",
            "info": "Keep it short."
        },
        {
            "type": "richtext",
            "id": "title",
            "label": "Title",
            "info": "Keep it short. ~50 characters (5-8 words, 2 lines). Hint: use Heading 2 for title, and paragraph for body"
        },        
        {
          "type": "checkbox",
          "id": "hide_variant_selectors",
          "label": "Hide variant selectors",
          "default": false
        }
    ],
    "max_blocks": 5,
    "blocks": [
        {
            "type": "slide",
            "name": "Slide",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Jet Lag Carousel | AW"
        }
    ]
}
{% endschema %}
