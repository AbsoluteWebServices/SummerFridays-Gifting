{%- liquid
    assign padding_top = section.settings.padding_top | default: 0
    assign padding_bottom = section.settings.padding_bottom | default: 0
    assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
    assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

    assign content = section.settings.content
    assign count = 0
-%}

{%- render 'offset',
    id: section.id,
    padding_top: padding_top,
    padding_bottom: padding_bottom,
    padding_top_desktop: padding_top_desktop,
    padding_bottom_desktop: padding_bottom_desktop
-%}

{%- render 'adastra' with 'styles/sections/articles.scss' -%}

<section 
    id="section-{{- section.id -}}"
>
    <div 
        class="container container--blog"
    >
        {%- if content != blank -%}
            <div class="rte article-related-posts__content">
                {{- content -}}
            </div>
          {%- endif -%}

        {%- paginate blog.articles by 50 -%}
            <div class="articles">
            {%- for related_article in blogs[blog.handle].articles -%}
                <div class="article article--related">
                    {%- unless related_article.handle == article.handle -%}
                    {%- render 'article-card', article: related_article -%}
                    {%- assign count = count | plus: 1 -%}
                    {%- if count == 4 -%}
                        {%- break -%}
                    {%- endif -%}
                    {%- endunless -%}
                </div>
            {%- endfor -%}
            </div>
        {%- endpaginate -%}
    </div>
</section>

{% schema %}
    {
      "name": "Article related posts",
      "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Main Settings"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "info": "Hint: use Heading 2 for title, and paragraph for body"
        }
      ],
      "enabled_on": {
        "templates": ["article"]
      },
      "presets": [
          {
            "name": "Article related posts"
          }
      ]
    }
{% endschema %}