{%- if settings.yotpo_app_key != blank -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign content = section.settings.content
    -%}

    {%- render 'offset',
        id: 'reviews',
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/reviews.scss' -%}

    <section id="section-reviews" x-data>
        <div class="reviews-wrapper"
            x-intersect.once="() => {
                const script = document.createElement('script');

                script.src = 'https://cdn-widgetsrepository.yotpo.com/v1/loader/{{- settings.yotpo_app_key -}}?languageCode={{ localization.language.iso_code | escape }}';

                document.body.appendChild(script);
            }"
        >
            {%- if content != blank -%}
                <div class="rte reviews__content">
                    {{- content -}}
                </div>
            {%- endif -%}

            <div
                class="yotpo-widget-instance"
                data-yotpo-instance-id="464451"
                data-yotpo-product-id="{{ product.id }}"
                data-yotpo-name="{{ product.title | escape }}"
                data-yotpo-url="{{ shop.url }}{{ product.url }}"
                data-yotpo-image-url="{{ product.featured_image | image_url | replace: '?', '%3F' | replace: '&','%26'}}" 
                data-yotpo-description="{{ product.description | escape }}"
            ></div>
        </div>
    </section>
{%- endif -%}

{% schema %}
  {
    "name": "Product Reviews | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Main Settings"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "default": "<h2>Reviews</h2>",
            "info": "Hint: use Heading 2 for title, and paragraph for body"
        }
    ],
    "presets": [
        {
            "name": "Product Reviews | AW"
        }
    ]
  }
{% endschema %}
