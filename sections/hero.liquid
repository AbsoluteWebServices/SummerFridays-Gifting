{%- if section.settings.video_desktop or section.settings.image_desktop -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign gradient_direction = section.settings.gradient_direction | default: 'gradient-y'
        assign text_color = section.settings.text_color | default: 'white'
        assign media_type = section.settings.media_type | default: 'video'
        assign height = section.settings.height | default: 100 | append: 'svh'
        assign video_desktop = section.settings.video_desktop
        assign video_mobile = section.settings.video_mobile | default: video_desktop
        assign image_desktop = section.settings.image_desktop
        assign image_mobile = section.settings.image_mobile | default: image_desktop
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/hero.scss' -%}

    <section id="section-{{- section.id -}}">
        <div class="aw-hero aw-hero--{{- gradient_direction -}}" style="color: var(--{{- text_color -}}); --aw-hero-min-height: {{- height -}};">
            {%- if media_type == 'image' -%}
                {%- render 'picture', 
                    image_desktop: image_desktop,
                    image_mobile: image_mobile,
                    loading: 'eager'
                -%}
            {%- elsif media_type == 'video' -%}
                {%- render 'video', 
                    video: video_mobile, 
                    poster: image_mobile, 
                    play_control: true,
                    wrapper_class: 'aw-hero__video-wrapper--mobile'
                -%}
                {%- render 'video', 
                    video: video_desktop, 
                    poster: image_desktop, 
                    play_control: true,
                    wrapper_class: 'aw-hero__video-wrapper--desktop'
                -%}
            {%- endif -%}

            <div class="aw-hero__container">
                {%- for block in section.blocks -%}
                    {%- assign type = block.type -%}
                    {%- case type -%}
                        {%- when 'title_subtitle_cta' -%}
                            {%- liquid 
                                assign title = block.settings.title
                                assign content = block.settings.content
                                if title == blank or content == blank 
                                    continue
                                endif

                                assign button_label = block.settings.button_label | escape 
                                assign button_url = block.settings.button_url
                            -%}

                            <div class="aw-hero__title">{{- title -}}</div>

                            <div class="aw-hero__content">
                                <div class="aw-hero__text rte p-large">{{- content -}}</div>

                                {%- if button_label != blank and button_url != blank -%}
                                    {%- liquid 
                                        assign target = block.settings.button_target | default: '_self'
                                        assign button_style = block.settings.button_style | default: 'white-transparent'
                                    -%}
                                    <a
                                        class="btn btn--center btn--{{ button_style }} aw-hero__link"
                                        href="{{- button_url -}}"
                                        title="{{- block.settings.link_text -}}"
                                        {% if target != '_self' %}
                                            target="{{- target -}}"
                                        {% endif %}
                                    >
                                        {{- button_label -}}
                                        {%- render 'icon', name: 'arrow-right' -%}
                                    </a>
                                {%- endif -%}
                            </div>
                    {%- endcase -%}
                {%- endfor -%}
            </div>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
    "name": "Hero | AW",
    "max_blocks": 1,
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Media Settings"
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "Media type",
            "default": "video",
            "options": [
                { "value": "image", "label": "Image" },
                { "value": "video", "label": "Video" }
            ]
        },
        {
            "type": "range",
            "id": "height",
            "label": "Height (% of the screen height)",
            "min": 5,
            "max": 100,
            "step": 1,
            "default": 100,
            "unit": "%"
        },
        {
            "type": "video",
            "id": "video_desktop",
            "label": "Video desktop",
            "info": "Format: .mp4"
        },
        {
            "type": "video",
            "id": "video_mobile",
            "label": "Video mobile",
            "info": "Format: .mp4; If not uploaded, defaults to the desktop video"
        },
        {
            "type": "image_picker",
            "id": "image_desktop",
            "label": "Desktop image",
            "info": "With the video type, the image is used as a poster (first frame)"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Mobile image",
            "info": "With the video type, the image is used as a poster (first frame). If not uploaded, defaults to the desktop image"
        },
        {
            "type": "select",
            "id": "gradient_direction",
            "label": "Gradient direction",
            "default": "gradient-y",
            "options": [
                { "value": "gradient-t", "label": "To Top" },
                { "value": "gradient-b", "label": "To Bottom" },
                { "value": "gradient-y", "label": "Vertical Sides" },
                { "value": "gradient-none", "label": "Off" }
            ]
        },
        {
            "type": "header",
            "content": "Text Settings"
        },
        {
            "type": "select",
            "id": "text_color",
            "label": "Text Color",
            "default": "white",
            "options": [
                { "value": "black", "label": "Black" },
                { "value": "white", "label": "White"}
            ]
        }
    ],
    "blocks": [
        {
            "name": "Title, Subtitle and CTA",
            "type": "title_subtitle_cta",
            "settings": [
                {
                    "type": "richtext",
                    "id": "title",
                    "label": "Title",
                    "info": "Keep it short. ~50 characters (5-8 words, 2 lines)"
                },
                {
                    "type": "richtext",
                    "id": "content",
                    "label": "Content",
                    "info": "Recommendation: ~160 characters (20-25 words)"
                },
                {
                    "type": "text",
                    "id": "button_label",
                    "label": "Button label"
                },
                {
                    "type": "url",
                    "id": "button_url",
                    "label": "Button URL"
                },
                {
                    "type": "select",
                    "id": "button_target",
                    "label": "Button Target",
                    "default": "_self",
                    "options": [
                        { "value": "_blank", "label": "Blank" },
                        { "value": "_self", "label": "Self" }
                    ],
                    "info": "Blank opens in a new tab."
                },
                {
                    "type": "select",
                    "id": "button_style",
                    "label": "Button Style",
                    "default": "white-transparent",
                    "options": [
                        { "value": "white-transparent", "label": "White transparent" },
                        { "value": "black-transparent", "label": "Black transparent" }
                    ]
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Hero | AW"
        }
    ]
}
{% endschema %}
