{%- if section.blocks.size > 0 -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign text_color = section.settings.text_color | default: 'white'
        assign title_color = section.settings.title_color | default: 'white'
        assign content_color = section.settings.content_color | default: 'white'
        assign title_tag = section.settings.title_tag | default: 'h1'
        assign overlay_opacity = section.settings.overlay_opacity | default: 10 | divided_by: 100.0
        assign gradient_direction = section.settings.gradient_direction | default: 'gradient-none'
        assign gradient_percent = section.settings.gradient_percent | default: 25
        assign vertical_alignment_desktop = section.settings.vertical_alignment_desktop | default: 'center'
        assign horizontal_alignment_desktop = section.settings.horizontal_alignment_desktop | default: 'center'
        assign vertical_alignment_mobile = section.settings.vertical_alignment | default: 'center'
        assign horizontal_alignment_mobile = section.settings.horizontal_alignment | default: 'center'
        assign alignment_container_mobile = section.settings.alignment_container | default: 'full'
        assign alignment_container_desktop = section.settings.alignment_container_desktop | default: 'full'
        assign eyebrow = section.settings.eyebrow | escape | strip_html
        assign eyebrow_margin = section.settings.eyebrow_margin | default: 'normal'
        assign content_above_title = section.settings.content_above_title
        assign title = section.settings.title | escape | strip_html
        assign title_custom_line_1 = section.settings.title_custom_line_1 | escape | strip_html
        assign title_custom_line_2 = section.settings.title_custom_line_2 | escape | strip_html
        assign content = section.settings.content
        assign title_font = section.settings.title_font | default: 'primary'
        assign button_label = section.settings.button_label | escape | strip_html
        assign button_url = section.settings.button_url
        assign button_margin = section.settings.button_margin | default: 'normal'
        assign btn_style = section.settings.btn_style | default: 'regular'
        assign btn_color = section.settings.btn_color | default: 'white-transparent'

        # height
        # height mobile
        assign height_type = section.settings.height_type | default: 'percentage'
        assign height = section.settings.height | default: 100 | append: 'svh'
        assign deduct_header_height = section.settings.deduct_header_height | default: false
        assign deduct_announcement_bar_height = section.settings.deduct_announcement_bar_height | default: false
        assign aspect_ratio_width = section.settings.aspect_ratio_width | default: 1
        assign aspect_ratio_height = section.settings.aspect_ratio_height | default: 1

        # height tablet
        assign height_type_tablet = section.settings.height_type_tablet | default: 'percentage'
        assign height_tablet = section.settings.height_tablet | default: 100 | append: 'svh'
        assign deduct_header_height_tablet = section.settings.deduct_header_height_tablet | default: false
        assign deduct_announcement_bar_height_tablet = section.settings.deduct_announcement_bar_height_tablet | default: false
        assign aspect_ratio_width_tablet = section.settings.aspect_ratio_width_tablet | default: 16
        assign aspect_ratio_height_tablet = section.settings.aspect_ratio_height_tablet | default: 9

        # height desktop
        assign height_type_desktop = section.settings.height_type_desktop | default: 'percentage'
        assign height_desktop = section.settings.height_desktop | default: 100 | append: 'svh'
        assign deduct_header_height_desktop = section.settings.deduct_header_height_desktop | default: false
        assign deduct_announcement_bar_height_desktop = section.settings.deduct_announcement_bar_height_desktop | default: false
        assign aspect_ratio_width_desktop = section.settings.aspect_ratio_width_desktop | default: 16
        assign aspect_ratio_height_desktop = section.settings.aspect_ratio_height_desktop | default: 9

        # font size
        assign title_font_size = section.settings.title_font_size | default: 3
        assign title_font_size_tablet = section.settings.title_font_size_tablet | default: 3
        assign title_font_size_desktop = section.settings.title_font_size_desktop | default: 3

        assign content_font_size = section.settings.content_font_size | default: 1
        assign content_font_size_tablet = section.settings.content_font_size_tablet | default: 1
        assign content_font_size_desktop = section.settings.content_font_size_desktop | default: 1

        # custom colors
        assign text_color_custom = section.settings.text_color_custom
        assign title_color_custom = section.settings.title_color_custom
        assign content_color_custom = section.settings.content_color_custom
        assign btn_color_custom = section.settings.btn_color_custom
        assign btn_color_custom_hover = section.settings.btn_color_custom_hover
        assign btn_color_custom_label = section.settings.btn_color_custom_label
        assign btn_color_custom_label_hover = section.settings.btn_color_custom_label_hover
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/hero-split.scss' -%}

    <style>
        {% if btn_color == 'custom' %}
            #section-{{- section.id }} .btn.hero-split__content-btn {
                color: {{ btn_color_custom_label }};
                background-color: {{ btn_color_custom }};
                border-color: {{ btn_color_custom }};
            }

            #section-{{- section.id }} .btn.hero-split__content-btn:hover,
            #section-{{- section.id }} .btn.hero-split__content-btn:focus {
                color: {{ btn_color_custom_label_hover }};
                background-color: {{ btn_color_custom_hover }};
                border-color: {{ btn_color_custom_hover }};
            }
        {% endif %}

        #section-{{- section.id }} .hero-split__wrapper {
            {% if height_type == 'percentage' %}
                min-height: max(45rem, calc({{ height }}{% if deduct_header_height %} - var(--header-height-mobile){% endif %}{% if deduct_announcement_bar_height %} - var(--announcement-height, 0){% endif %}));
            {% else %}
                aspect-ratio: {{ aspect_ratio_width }} / {{ aspect_ratio_height }};
            {% endif %}
        }

        #section-{{- section.id }} .hero-split__title {
            font-size: {{ title_font_size }}rem;
            line-height: 1;
        }

        #section-{{- section.id }} .hero-split__content-content * {
            font-size: {{ content_font_size }}rem;
            line-height: normal;
        }

        @media only screen and (min-width: 768px) {
            #section-{{- section.id }} .hero-split__wrapper {
                {% if height_type_tablet == 'percentage' %}
                    aspect-ratio: initial;
                    min-height: max(45rem, calc({{ height_tablet }}{% if deduct_header_height_tablet %} - var(--header-height-mobile){% endif %}{% if deduct_announcement_bar_height_tablet %} - var(--announcement-height, 0){% endif %}));
                {% else %}
                    min-height: initial;
                    aspect-ratio: {{ aspect_ratio_width_tablet }} / {{ aspect_ratio_height_tablet }};
                {% endif %}
            }

            #section-{{- section.id }} .hero-split__title {
                font-size: {{ title_font_size_tablet }}rem;
            }

            #section-{{- section.id }} .hero-split__content-content * {
                font-size: {{ content_font_size_tablet }}rem;
            }
        }

        @media only screen and (min-width: 1280px) {
            #section-{{- section.id }} .hero-split__wrapper {
                {% if height_type_desktop == 'percentage' %}
                    aspect-ratio: initial;
                    min-height: max(45rem, calc({{ height_desktop }}{% if deduct_header_height_desktop %} - var(--header-height-desktop){% endif %}{% if deduct_announcement_bar_height_desktop %} - var(--announcement-height, 0){% endif %}));
                {% else %}
                    min-height: initial;
                    aspect-ratio: {{ aspect_ratio_width_desktop }} / {{ aspect_ratio_height_desktop }};
                {% endif %}
            }

            #section-{{- section.id }} .hero-split__title {
                font-size: {{ title_font_size_desktop }}rem;
            }

            #section-{{- section.id }} .hero-split__content-content * {
                font-size: {{ content_font_size_desktop }}rem;
            }
        }
    </style>

    {%- capture content_html -%}
        <div class="
            hero-split__content-wrapper
            hero-split__content-wrapper--y-m-{{- vertical_alignment_mobile }} 
            hero-split__content-wrapper--x-m-{{- horizontal_alignment_mobile }}
            hero-split__content-wrapper--y-{{- vertical_alignment_desktop }} 
            hero-split__content-wrapper--x-{{- horizontal_alignment_desktop }}
            hero-split__content-wrapper-ac-m-{{- alignment_container_mobile }}
            hero-split__content-wrapper-ac-d-{{- alignment_container_desktop }}
        ">
            <div class="hero-split__content">
                {%- if eyebrow != blank -%}
                    <div class="subheader-large hero-split__content-eyebrow hero-split__content-eyebrow--m-{{- eyebrow_margin -}}" style="color: {% if text_color == 'custom' %}{{ text_color_custom }}{% else %}var(--{{- text_color -}}){% endif %};">{{- eyebrow -}}</div>
                {%- endif -%}

                {%- if content_above_title != blank -%}
                    <div class="rte hero-split__content-content" style="color: {% if content_color == 'custom' %}{{ content_color_custom }}{% else %}var(--{{- content_color -}}){% endif %};">
                        {{- content_above_title -}}
                    </div>
                {%- endif -%}

                {%- if title != blank -%}
                    <{{- title_tag }} class="hero-title-{{- title_font }} hero-split__title" style="color: {% if title_color == 'custom' %}{{ title_color_custom }}{% else %}var(--{{- title_color -}}){% endif %};">
                        {{- title -}}
                    </{{- title_tag -}}>
                {%- elsif title_custom_line_1 != blank or title_custom_line_2 != blank -%}
                        <{{- title_tag }} style="color: {% if title_color == 'custom' %}{{ title_color_custom }}{% else %}var(--{{- title_color -}}){% endif %};">
                        {%- if title_custom_line_1 != blank -%}
                            <span class="hero-split__title-custom-1">{{- title_custom_line_1 -}}</span>
                        {%- endif -%}
                        {%- if title_custom_line_1 != blank and title_custom_line_2 != blank -%}<br>{%- endif -%}
                        {%- if title_custom_line_2 != blank -%}
                            <span class="hero-split__title-custom-2">{{- title_custom_line_2 -}}</span>
                        {%- endif -%}
                        </{{- title_tag -}}>
                {%- endif -%}

                {%- if content != blank -%}
                    <div class="rte hero-split__content-content" style="color: {% if content_color == 'custom' %}{{ content_color_custom }}{% else %}var(--{{- content_color -}}){% endif %};">
                        {{- content -}}
                    </div>
                {%- endif -%}

                {%- if button_label != blank and button_url != blank -%}
                    <a 
                        href="{{- button_url -}}" 
                        class="btn btn--w-min btn--{{ btn_color }} hero-split__content-btn hero-split__content-btn--m-{{- button_margin }} {% if btn_style == 'with_arrow' %}btn--center{% endif %}"
                        aria-label="{{- button_label -}}">
                        {{- button_label -}}
                        {%- if btn_style == 'with_arrow' -%}
                            {%- render 'icon', name: 'arrow-right' -%}
                        {%- endif -%}
                    </a>
                {%- endif -%}
            </div>
        </div>
    {%- endcapture -%}

    <section 
        id="section-{{- section.id -}}"
    >
        <div 
            class="
                hero-split__wrapper hero-split__wrapper--{{- gradient_direction }} 
            "
            style="--gradient-percent: {{- gradient_percent -}}%"
        >
            {%- if overlay_opacity > 0 -%}
                <div class="hero-split__overlay" style="opacity: {{- overlay_opacity -}};"></div>
            {%- endif -%}

            <div class="hero-split__media-wrapper {% if section.blocks.size == 2 %}hero-split__media-wrapper--two{% endif %}">
                {%- for block in section.blocks -%}
                    {%- liquid 
                        assign media_type = block.settings.media_type | default: 'video'
                        assign video_desktop = block.settings.video_desktop
                        assign video_mobile = block.settings.video_mobile | default: video_desktop
                        assign image_desktop = block.settings.image_desktop
                        assign image_mobile = block.settings.image_mobile | default: image_desktop 
                    -%}
                    <div class="hero-split__media">
                        {%- if media_type == 'image' -%}
                            {%- render 'picture', 
                                image_desktop: image_desktop,
                                image_mobile: image_mobile,
                                loading: 'eager'
                            -%}
                        {%- elsif media_type == 'video' -%}
                            {%- render 'video', 
                                video: video_mobile, 
                                poster: image_mobile, 
                                wrapper_class: 'aw-hero__video-wrapper--mobile'
                            -%}
                            {%- render 'video', 
                                video: video_desktop, 
                                poster: image_desktop, 
                                wrapper_class: 'aw-hero__video-wrapper--desktop'
                            -%}
                        {%- endif -%}
                    </div>
                {%- endfor -%}
            </div>
            
            {{- content_html -}}
        </div>
    </section>
{%- endif -%}

