{%- if section.settings.title != blank -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign title = section.settings.title
        assign align = section.settings.align | default: 'left'
        assign max_width = section.settings.max_width | default: 0
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    <section id="section-{{ section.id }}">
        <div class="container">
            <div
                class="rte"
                style="text-align:{{ align }};{% if max_width > 0 %}max-width:{{ max_width }}rem;margin: 0 auto;{% endif %}"
            >
                {{- title -}}
            </div>
        </div>
    </section>
{%- endif -%}
{% schema %}
{
    "name": "Title | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "richtext",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "select",
            "id": "align",
            "label": "Align",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "left"
        },
        {
            "type": "number",
            "id": "max_width",
            "label": "Max width (rem)",
            "info": "1rem = 10px; set 0 to make it fullwidth."
        }
    ],
    "presets": [
        {
            "name": "Title | AW"
        }
    ]
}
{% endschema %}
