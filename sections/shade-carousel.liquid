{%- if section.blocks.size > 0 -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign title = section.settings.title | escape
        assign show_dropdown = section.settings.show_dropdown | default: false
        assign show_toggle = section.settings.show_toggle | default: false
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/shade-carousel.scss' -%}

    <section 
        id="section-{{- section.id -}}"
        x-data="shadeCarousel('{{- section.id -}}')"
        data-split-load-section
    >
        <div class="container">
            {%- if title != blank -%}
                <div class="shade-carousel__content">
                    <h2>
                        {{- title -}}
                        {%- if show_dropdown -%}
                            <div class="shade-carousel__dropdown">
                                <button
                                    class="shade-carousel__dropdown-toggle"
                                    :class="dropdownOpen && 'is-open'"
                                    aria-controls="shade-carousel-dropdown"
                                    :aria-expanded="dropdownOpen"
                                    aria-label="Toggle dropdown"
                                    @click.prevent="dropdownOpen = !dropdownOpen"
                                >
                                    <span x-text="sliderName">{{ section.blocks[0].settings.slider_name }}</span>
                                    {%- render 'icon', name: 'chevron-down' -%}
                                </button>
                                <ul
                                    id="shade-carousel-dropdown"
                                    class="dropdown-content shade-carousel__dropdown-content"
                                    :data-open="dropdownOpen"
                                    :style="dropdownOpen && { height: $el.scrollHeight + 'px' }"
                                    @resize.window="if (!dropdownOpen) { return; } $el.style.height = 'auto'"
                                >
                                    {%- for block in section.blocks -%}
                                        <li
                                            @click="activeSlider = {{ forloop.index }}; $nextTick(() => {
                                                alignButtons();
                                                sliderName = '{{- block.settings.slider_name -}}';
                                                dropdownOpen = false;
                                            });"
                                            :class="sliderName === '{{- block.settings.slider_name -}}' && 'active'"
                                        >
                                            {{- block.settings.slider_name -}}
                                        </li>
                                    {%- endfor -%}
                                </ul>
                            </div>
                        {%- endif -%}
                    </h2>
                    {%- if show_toggle -%}
                        <button
                            class="shade-carousel__toggle"
                            @click.prevent="toggle = !toggle"
                            :class="toggle === true && 'shade-carousel__toggle--active'"
                        ></button>
                    {%- endif -%}
                </div>
            {%- endif -%}

            {%- for block in section.blocks -%}
                {%- liquid
                    if show_dropdown == false and forloop.index > 1
                        continue
                    endif

                    assign slider_name = block.settings.slider_name
                -%}
                <div 
                    class="swiper shade-carousel__slider{% if forloop.index == 1 %} shade-carousel__slider--active{% endif %}"
                    x-intersect.once="initSlider($el, '{{ slider_name }}')"
                    :class="{ 'shade-carousel__slider--active': activeSlider === {{ forloop.index }} }"
                >
                    <ul class="swiper-wrapper list-reset">
                        {%- for i in (1..14) -%}
                            {%- capture image_key -%}image_{{ i }}{%- endcapture -%}
                            {%- capture title_key -%}title_{{ i }}{%- endcapture -%}
                            {%- liquid 
                                assign image = block.settings[image_key]
                                assign title = block.settings[title_key]
                                if image == blank
                                    continue
                                endif
                            -%}
                            {%- capture toggle_image_key -%}toggle_image_{{ i }}{%- endcapture -%}
                            {%- capture hover_media_type_key -%}hover_media_type_{{ i }}{%- endcapture -%}
                            {%- capture hover_image_key -%}hover_image_{{ i }}{%- endcapture -%}
                            {%- capture hover_video_key -%}hover_video_{{ i }}{%- endcapture -%}
                            {%- capture text_key -%}text_{{ i }}{%- endcapture -%}
                            {%- liquid
                                assign toggle_image = block.settings[toggle_image_key]
                                assign hover_media_type = block.settings[hover_media_type_key] | default: 'image'
                                assign hover_image = block.settings[hover_image_key]
                                assign hover_video = block.settings[hover_video_key]
                                assign text = block.settings[text_key] | escape
                            -%}

                            {%- render 'shade-carousel-slide',
                                image: image,
                                toggle_image: toggle_image,
                                hover_media_type: hover_media_type,
                                hover_image: hover_image,
                                hover_video: hover_video,
                                title: title,
                                text: text
                            -%}
                        {%- endfor -%}
                    </ul>

                    <button
                        class="swiper-nav-btn swiper-button-disabled swiper-nav-btn--prev hover-opacity"
                        type="button"
                        aria-label="Go to the previous slide"
                        data-swiper-prev
                    >
                        {%- render 'icon', name: 'swiper-chevron' -%}
                    </button>
    
                    <button
                        class="swiper-nav-btn swiper-button-disabled swiper-nav-btn--next hover-opacity"
                        type="button"
                        aria-label="Go to the next slide"
                        data-swiper-next
                    >
                        {%- render 'icon', name: 'swiper-chevron' -%}
                    </button>
                </div>
            {%- endfor -%}
        </div>
    </section>
{%- endif -%}

