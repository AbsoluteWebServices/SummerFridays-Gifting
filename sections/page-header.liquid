{%- liquid
    assign padding_top = section.settings.padding_top | default: 0
    assign padding_bottom = section.settings.padding_bottom | default: 0
    assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
    assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

    assign content = section.settings.content
    assign vertical_alignment = section.settings.vertical_alignment | default: 'bottom'
    assign horizontal_alignment = section.settings.horizontal_alignment | default: 'left'
    assign container = section.settings.container | default: 'none'
    assign media_type = section.settings.media_type | default: 'image'
    assign lazyload = section.settings.lazyload | default: false
    assign image_desktop = section.settings.image
    assign image_mobile = section.settings.image_mobile | default: image_desktop
    assign video = section.settings.video
    assign overlay_opacity = section.settings.overlay_opacity | default: 10 | divided_by: 100.0
    assign gradient_direction = section.settings.gradient_direction | default: 'gradient-b'
    assign gradient_percent = section.settings.gradient_percent | default: 25
    assign button_label = section.settings.button_label | escape | strip_html
    assign button_url = section.settings.button_url
    assign link_appearance = section.settings.link_appearance | default: 'button'
    assign arrow_direction = section.settings.arrow_direction | default: 'right'
    assign loading = 'eager'
    if lazyload == true 
        assign loading = 'lazy'
    endif

    assign icon_arrow_name = arrow_direction | prepend: 'arrow-'
-%}

{%- render 'offset',
    id: section.id,
    padding_top: padding_top,
    padding_bottom: padding_bottom,
    padding_top_desktop: padding_top_desktop,
    padding_bottom_desktop: padding_bottom_desktop
-%}

{%- render 'adastra' with 'styles/sections/page-header.scss' -%}

<section id="section-{{- section.id -}}">
    <div 
        class="page-header page-header--{{- gradient_direction }} page-header--y-{{- vertical_alignment }} page-header--x-{{- horizontal_alignment }}"
        style="--gradient-percent: {{- gradient_percent -}}%"
    >
        {%- if overlay_opacity > 0 -%}
            <div class="page-header__overlay" style="opacity: {{- overlay_opacity -}};"></div>
        {%- endif -%}

        {%- if media_type == 'image' -%}
            {%- if image_desktop -%}
                {%- render 'picture',
                    image_desktop: image_desktop,
                    image_mobile: image_mobile,
                    loading: loading
                -%}
            {%- endif -%}
        {%- elsif media_type == 'video' -%}
            {%- if video -%}
                {%- render 'video', 
                    video: video,
                    poster: image
                -%}
            {%- endif -%}
        {%- endif -%}

        {%- if content != blank -%}
            <div class="page-header__body">
                <div class="container {% if container != blank and container != 'none' %}container--{{ container }}{% endif %}">
                    <div class="rte">
                        {{- content -}}

                        {%- if button_label != blank and button_url != blank -%}
                            <p>
                                <a 
                                    href="{{- button_url -}}" aria-label="{{- button_label -}}" 
                                    class="{% if link_appearance == 'button' %}btn btn--white-transparent btn--center btn--w-min{% else %}cta-textlink cta-link-with-arrow cta-link-with-arrow--{{ arrow_direction }}{% endif %}"
                                >
                                    {{- button_label -}}
                                    {%- render 'icon', name: icon_arrow_name -%}
                                </a>
                            </p>
                        {%- endif -%}
                    </div>
                </div>
            </div>
        {%- endif -%}
    </div>
</section>

{% schema %}
{
    "name": "Page Header | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Settings"
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "Media type",
            "default": "video",
            "options": [
                { "value": "image", "label": "Image" },
                { "value": "video", "label": "Video" }
            ]
        },
        {
            "type": "checkbox",
            "id": "lazyload",
            "label": "Lazyload",
            "default": false,
            "info": "Enable if the media is below the fold."
        },
        {
            "type": "video",
            "id": "video",
            "label": "Video",
            "info": "Format: .mp4"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "With the video type, the image is used as a poster (first frame)"
        },
        {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Image (mobile)",
            "info": "If not uploaded, defaults to the desktop image."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 20
        },
        {
            "type": "select",
            "id": "gradient_direction",
            "label": "Gradient direction",
            "default": "gradient-b",
            "options": [
                { "value": "gradient-t", "label": "To Top" },
                { "value": "gradient-b", "label": "To Bottom" },
                { "value": "gradient-y", "label": "Vertical Sides" },
                { "value": "gradient-none", "label": "Off" }
            ]
        },
        {
            "type": "range",
            "id": "gradient_percent",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "label": "Gradient percent (height)",
            "default": 25
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Hint: use H1 for title; paragraph for regular text."
        },
        {
            "type": "select",
            "id": "vertical_alignment",
            "label": "Vertical alignment",
            "default": "bottom",
            "options": [
                { "value": "top", "label": "Top" },
                { "value": "center", "label": "Center" },
                { "value": "bottom", "label": "Bottom" }
            ]
        },
        {
            "type": "select",
            "id": "horizontal_alignment",
            "label": "Horizontal alignment",
            "default": "left",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Center" },
                { "value": "right", "label": "Right" }
            ]
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container",
            "default": "none",
            "options": [
                { "value": "page", "label": "Page" },
                { "value": "blog", "label": "Blog" },
                { "value": "small", "label": "Small" },
                { "value": "medium", "label": "Medium" },
                { "value": "none", "label": "None" }
            ]
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "link_appearance",
          "label": "Link appearance",
          "default": "button",
          "options": [
              { "value": "link", "label": "Link" },
              { "value": "button", "label": "Button" }
          ]
        },
        {
          "type": "select",
          "id": "arrow_direction",
          "label": "Arrow direction",
          "default": "right",
          "options": [
              { "value": "right", "label": "Right" },
              { "value": "down", "label": "Down" }
          ]
        }
    ],
    "presets": [
        {
            "name": "Page Header | AW"
        }
    ]
}
{% endschema %}
