{%- if section.blocks.size > 0 -%}
    {%- liquid
        assign title = section.settings.title
        assign active_slide = section.blocks.size | divided_by: 2 | minus: 1

        assign learn_more = section.settings.learn_more | default: 'Learn more'

        assign loop = section.settings.loop | default: false

        assign mobile_image_height = section.settings.mobile_image_height
        assign tablet_image_height = section.settings.tablet_image_height
        assign desktop_image_height = section.settings.desktop_image_height

        assign default_product = section.blocks[active_slide].settings.product
        assign default_product_title = default_product.title 
        if default_product.metafields.accentuate.plp_title != blank
            assign default_product_title = default_product.metafields.accentuate.plp_title | escape
        endif
        assign default_product_title_html = default_product_title | split: ' - ' | first | strip | replace: '®', '<sup>®</sup>' | replace: '™', '<sup>™</sup>'

        assign default_current_variant = default_product.selected_or_first_available_variant

        assign default_variant_title = ''
        if default_current_variant.title != 'Default Title'
            assign default_variant_title = default_current_variant.title

            assign variant_title_override = default_current_variant.metafields.variant.variant_title_override | escape 
            if variant_title_override != blank 
                assign default_variant_title = variant_title_override
            endif
        endif

        assign default_product_subtitle = default_product.metafields.accentuate.product_type | escape

        assign default_product_price = default_current_variant.price

        assign coming_soon = default_product.metafields.product.enable_coming_soon | default: false
        assign notify_me = default_product.metafields.product.enable_notify_me | default: false

        assign default_button_disabled = false
        assign default_button_label = 'products.product.add_to_cart' | t
        unless default_current_variant.available 
            if coming_soon
                assign default_button_label = 'products.product.coming_soon' | t
            elsif notify_me
                assign default_button_label = 'products.product.notify_me' | t
            else 
                assign default_button_label = 'products.product.sold_out' | t
                assign default_button_disabled = true
            endif
        endunless

        assign initial_text_color = section.blocks[active_slide].settings.text_color
        assign initial_background_color = section.blocks[active_slide].settings.background_color
        assign initial_background_image = section.blocks[active_slide].settings.image

        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/lip-butter-carousel.scss' -%}

    <section id="section-{{- section.id -}}" x-data="lipButterCarousel({{- active_slide -}})" x-intersect.once="initSlider({{- loop -}})" data-split-load-section>
        <div 
            class="lip-butter-carousel"
            data-text-color="{{ initial_text_color }}"
            :data-text-color="data?.text_color ? data.text_color : '{{ initial_text_color }}'"
            :style="{
                backgroundColor: data ? data.background_color : '{{ initial_background_color }}'
            }"
            style="background-color: {{ initial_background_color }}"
        >
            {%- for block in section.blocks -%}
                {%- assign image = block.settings.image -%}
                {%- unless image -%}
                    {%- continue -%}
                {%- endunless -%}

                {%- capture attributes -%}
                    x-show="data ? data.index == {{ forloop.index0 }} : {{ active_slide }} === {{ forloop.index0 }}"
                    x-transition:enter="default-transition"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-1"
                    x-transition:leave="default-transition"
                    x-transition:leave-start="opacity-1"
                    x-transition:leave-end="opacity-0"
                    {% if active_slide != forloop.index0 %}
                        style="display: none;"
                    {% endif %}
                {%- endcapture -%}

                {%- render 'img', 
                    image: image, 
                    class: 'lip-butter-carousel__bg-image',
                    attributes: attributes 
                -%}
            {%- endfor -%}

            <div class="lip-butter-carousel__container">
                {%- if title != blank -%}
                    <div class="rte lip-butter-carousel__title">
                        {{- title -}}
                    </div>
                {%- endif -%}

                <div class="lip-butter-carousel__slider swiper" x-ref="slider">
                    <div class="swiper-wrapper">
                        {%- for block in section.blocks -%}
                            {%- liquid
                                assign product = block.settings.product
                                assign product_image = product.metafields.custom.main_media_on_lip_butter_carousel | default: product.featured_image
                                assign background_color = block.settings.background_color | default: ''
                                assign text_color = block.settings.text_color | default: ''
                            -%}

                            {%- if product != blank -%}
                                {%- liquid 
                                    assign product_title = product.title 
                                    if product.metafields.accentuate.plp_title != blank
                                        assign product_title = product.metafields.accentuate.plp_title | escape
                                    endif
                                    assign product_title_html = product_title | split: ' - ' | first | strip | replace: '®', '<sup>®</sup>' | replace: '™', '<sup>™</sup>'
                            
                                    assign current_variant = product.selected_or_first_available_variant
                            
                                    assign variant_title = ''
                                    if current_variant.title != 'Default Title'
                                        assign variant_title = current_variant.title
                            
                                        assign variant_title_override = current_variant.metafields.variant.variant_title_override | escape 
                                        if variant_title_override != blank 
                                            assign variant_title = variant_title_override
                                        endif
                                    endif
                            
                                    assign product_subtitle = product.metafields.accentuate.product_type | escape | default: ''

                                    assign coming_soon = product.metafields.product.enable_coming_soon | default: false
                                    assign notify_me = product.metafields.product.enable_notify_me | default: false
                                -%}
                                <div class="lip-butter-carousel__slide swiper-slide">
                                    <script data-lbb-product-settings type="application/json"> 
                                        {   
                                            "index": {{- forloop.index0 -}},
                                            "background_color": {{- background_color | json -}},
                                            "text_color": {{- text_color | json -}},
                                            "available": {{- current_variant.available -}},
                                            "coming_soon": {{- coming_soon -}},
                                            "notify_me": {{- notify_me -}},
                                            "variant_id": {{- current_variant.id -}},
                                            "title": {{- product_title | json -}},
                                            "title_html": {{- product_title_html | json -}},
                                            "variant_title": {{- variant_title | json -}},
                                            "url": {{- current_variant.url | json -}},
                                            "price": {{- current_variant.price -}},
                                            "product_subtitle": {{- product_subtitle | json -}}
                                        }
                                    </script>

                                    <div href="{{- current_variant.url -}}" class="lip-butter-carousel__image-wrapper">
                                        {%- if product_image != blank -%}
                                            <img
                                                class="lip-butter-carousel__image"
                                                src="{{- product_image | image_url -}}"
                                                height="{{- product_image.height -}}"
                                                width="{{- product_image.width -}}"
                                                alt="{{- product_image.alt | default: product_title -}}"
                                                loading="lazy">
                                        {%- endif -%}
                                    </div>
                                </div>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                </div>
                <div class="lip-butter-carousel__contents">
                    <div class="lip-butter-carousel__content">
                        <h3 
                            x-html="data?.title ? data.title_html : '{{ default_product_title_html }}'"
                            class="lip-butter-carousel__subtitle"
                        >{{- default_product_title_html -}}</h3> 
    
                        <div 
                            x-show="data ? Boolean(data.variant_title) : Boolean('{{ default_variant_title }}')"
                            x-text="data ? data.variant_title : '{{ default_variant_title }}'"
                            class="superscript-normal lip-butter-carousel__text"
                            {% if default_variant_title == blank %}
                                style="display: none;"
                            {% endif %}
                        >{{- default_variant_title -}}</div>

                        <div 
                            x-show="data ? Boolean(data.product_subtitle) : Boolean('{{ default_product_subtitle }}')"
                            x-text="data ? data.product_subtitle : '{{ default_product_subtitle }}'"
                            class="lip-butter-carousel__description"
                            {% if default_product_subtitle == blank %}
                                style="display: none;"
                            {% endif %}
                        >{{- default_product_subtitle -}}</div>

                        <form
                            class="lip-butter-carousel__form"
                            action="/cart/add"
                            method="POST"
                            enctype="multipart/form-data"
                            @submit.prevent="$store.Cart.addToCart(event)">
                            <input type="hidden" name="quantity" value="1">
                            <input type="hidden" name="id" :value="data ? data.variant_id : {{ default_current_variant.id }}" value="{{- default_current_variant.id -}}">

                            <button 
                                type="submit" 
                                class="lip-butter-carousel__button lip-butter-carousel__button--{{ text_color }} btn btn--full btn--between btn--clay"
                                {% if default_button_disabled %}
                                    disabled="disabled"
                                {% endif %}
                                :disabled="data ? !data.available : {{ default_button_disabled }}"
                            >
                                <span
                                    class="btn__inner-default"
                                    x-text="data ? (data.available ? '{{- 'products.product.add_to_cart' | t -}}' : data.coming_soon ? '{{ 'products.product.coming_soon' | t }}' : data.notify_me ? '{{ 'products.product.notify_me' | t }}' : '{{- 'products.product.sold_out' | t -}}') : '{{- default_button_label -}}'"
                                >{{- default_button_label -}}</span>
                                <span class="btn__inner-loading">
                                    {{ 'products.product.adding' | t }}
                                </span>
                                <span x-text="data ? window.Shopify.formatMoney(data.price) : '{{ default_product_price | money_without_trailing_zeros }}'">{{- default_product_price | money_without_trailing_zeros -}}</span>
                            </button>
                        </form>

                        <a
                            class="cta-textlink lip-butter-carousel__link"
                            href="{{- default_current_variant.url -}}"
                            :href="data ? data.url : '{{ default_current_variant.url }}'"
                            title="{{- default_product_title }} {{ default_variant_title -}}"
                            :title="data ? `${ data.title } ${ data.variant_title }` : '{{- default_product_title }} {{ default_variant_title -}}'"
                            aria-label="{{- default_product_title }} {{ default_variant_title -}}"
                            :aria-label="data ? `${ data.title } ${ data.variant_title }` : '{{- default_product_title }} {{ default_variant_title -}}'"
                        >
                            {{- learn_more -}}
                            {%- render 'icon', name: 'arrow-right' -%}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {%- style -%}
        .lip-butter-carousel {
            --lip-butter-active-slide: {{- active_slide -}};
            --lip-butter-mobile-image-height: {{- mobile_image_height -}}rem;
            --lip-butter-tablet-image-height: {{- tablet_image_height -}}rem;
            --lip-butter-desktop-image-height: {{- desktop_image_height -}}rem;
        }
    {%- endstyle -%}
{%- endif -%}

{% schema %}
{
    "name": "LBB Carousel | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "richtext",
            "id": "title",
            "label": "Title",
            "info": "Hint: use Heading 2 for title, and paragraph for body"
        },
        {
            "type": "text",
            "id": "learn_more",
            "label": "Learn more label",
            "default": "Learn more"
        },
        {
            "type": "header",
            "content": "Slider"
        },
        {
            "type": "checkbox",
            "id": "loop",
            "label": "Loop",
            "default": false
        },
        {
            "type": "header",
            "content": "Max Height"
        },
        {
            "type": "number",
            "id": "mobile_image_height",
            "label": "Mobile image height (rem)",
            "default": 34,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "tablet_image_height",
            "label": "Tablet image height (rem)",
            "default": 44,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "desktop_image_height",
            "label": "Desktop image height (rem)",
            "default": 34,
            "info": "1rem = 10px"
        }
    ],
    "blocks": [
        {
            "type": "slide",
            "name": "Slide",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                },
                {
                    "type": "text",
                    "id": "product_link_text",
                    "label": "Product Link Text",
                    "default": "Learn More"
                },
                {
                    "type": "header",
                    "content": "Styles"
                },
                {
                    "type": "color",
                    "id": "background_color",
                    "label": "Featured Background Color"
                }, 
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Featured Background Image"
                },
                {
                    "type": "select",
                    "id": "text_color",
                    "label": "Featured Text Color",
                    "default": "black",
                    "options": [
                        { "value": "white", "label": "White" },
                        { "value": "black", "label": "Black" }
                    ]
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "LBB Carousel | AW"
        }
    ]
}
{% endschema %}
