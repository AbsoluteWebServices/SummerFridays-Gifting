{%- liquid
  assign image = section.settings.image
  assign image_height = image.height | plus: 0.00
  assign image_width = image.width | plus: 0.00
  assign image_mobile = section.settings.image_mobile | default: image

  assign color = section.settings.color
  assign message = section.settings.message
  assign message_bottom = section.settings.message_bottom
  assign title = section.settings.title
  assign image_max_height = section.settings.image_max_height
  assign image_min_height = section.settings.image_min_height
  assign image_alt = section.settings.image_alt | default: image.alt | default: image_mobile.alt | default: 'Rewards Image'
  assign overlay_background_color = section.settings.overlay_background_color
  assign overlay_opacity = section.settings.opacity
  assign logged_in_widget_id = section.settings.logged_in_widget_id | strip_html | escape | strip

  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0
-%}

{%- render 'offset',
  id: section.id,
  padding_top: padding_top,
  padding_bottom: padding_bottom,
  padding_top_desktop: padding_top_desktop,
  padding_bottom_desktop: padding_bottom_desktop
-%}

{%- render 'adastra' with 'styles/sections/rewards-hero.scss' -%}

<section id="section-{{ section.id }}">
  <div class="rewards-hero">
    <figure class="rewards-hero__container">
      {% if image != blank %}
        <picture class="rewards-hero__picture"
          style="--ratio: {{ image_height | divided_by: image_width | times: 100 }}%;
            {% if image_max_height != blank and image_max_height > 0 %}--max-height: {{ image_max_height }}px{% endif %};
            {% if image_min_height != blank and image_min_height > 0 %}--min-height: {{ image_min_height }}px{% endif %};">
          <source srcset="{{ image | image_url }}" media="(min-width: 768px)">
          <img class="rewards-hero__image image-cover"
            src="{{ image_mobile | image_url: width: '768px' }}"
            {% if image_alt != blank %}alt="{{ image_alt | escape }}"{% endif %}>
        </picture>
      {% endif %}

      <figcaption class="rewards-hero__info"
        style="--color: {% if color != blank and color != 'rgba(0,0,0,0)' %}{{ color }}{% else %}var(--ink){% endif %};
          {% if overlay_background_color != blank and overlay_background_color != 'rgba(0,0,0,0)' %}--overlay-background-color: {{ overlay_background_color }};{% endif %}
          {% if overlay_opacity != blank %}--overlay-opacity: {{ overlay_opacity }}%;{% endif %}">
        <div class="rewards-hero__info-inner">
          {% if title != blank %}
            <div class="rewards-hero__title{% if customer %} rewards-hero__title--logged-in{% endif %} rte"
              role="heading"
              aria-level="2">
              {{ title }}
            </div>
          {% endif %}

          {% if message != blank %}
            <div class="rewards-hero__message rte">
              {{ message }}
            </div>
          {% endif %}

          {% unless customer %}
            <div class="rewards-hero__buttons">
                <a href="{{ routes.account_login_url }}" aria-label="{{- 'general.rewards.sign_in' | t -}}" class="rewards-hero__button btn btn--center hover-arrow">
                    {{- 'general.rewards.sign_in' | t -}}
                    {% render 'icon', name: 'swiper-arrow-right' %}
                </a>

                <a href="{{ routes.account_register_url }}" aria-label="{{- 'general.rewards.sign_up' | t -}}" class="rewards-hero__button btn btn--center hover-arrow">
                    {{- 'general.rewards.sign_up' | t -}}
                {% render 'icon', name: 'swiper-arrow-right' %}
                </a>
            </div>

            {% if message_bottom != blank %}
              <div class="rewards-hero__message rte">
                {{ message_bottom }}
              </div>
            {% endif %}
          {% endunless %}

          {% if customer and logged_in_widget_id != blank %}
            <div class="yotpo-widget-instance" data-yotpo-instance-id="{{- logged_in_widget_id -}}"></div>
          {% endif %}
        </div>
      </figcaption>
    </figure>
  </div>
</section>

{% schema %}
  {
    "name": "Rewards Hero | AW",
    "class": "shopify-section--rewards-hero",
    "settings": [
      {
        "type": "header",
        "content": "Paddings"
      },
      {
        "type": "number",
        "id": "padding_top",
        "label": "Padding top (rem)",
        "default": 3,
        "info": "1rem = 10px"
      },
      {
        "type": "number",
        "id": "padding_bottom",
        "label": "Padding bottom (rem)",
        "default": 3,
        "info": "1rem = 10px"
      },
      {
        "type": "number",
        "id": "padding_top_desktop",
        "label": "Padding top desktop (rem)",
        "default": 6,
        "info": "1rem = 10px"
      },
      {
        "type": "number",
        "id": "padding_bottom_desktop",
        "label": "Padding bottom desktop (rem)",
        "default": 6,
        "info": "1rem = 10px"
      },
      {
        "id": "image",
        "label": "Image (2000px x 638px)",
        "type": "image_picker"
      },
      {
        "id": "image_mobile",
        "label": "Mobile Image (767px x 638px)",
        "type": "image_picker"
      },
      {
        "id": "image_max_height",
        "label": "Image max-height",
        "type": "number"
      },
      {
        "id": "image_min_height",
        "label": "Image min-height",
        "type": "number"
      },
      {
        "id": "image_alt",
        "label": "Image Alt",
        "type": "text"
      },
      {
        "id": "title",
        "label": "Title",
        "type": "richtext"
      },
      {
        "id": "message",
        "label": "Note",
        "type": "richtext"
      },
      {
        "id": "message_bottom",
        "label": "Note (bottom)",
        "type": "richtext",
        "info": "Shown if customer is not logged in."
      },
      {
        "default": 30,
        "id": "opacity",
        "label": "Image Overlay Opacity",
        "max": 100,
        "min": 0,
        "step": 1,
        "type": "range",
        "unit": "%"
      },
      {
        "id": "overlay_background_color",
        "label": "Image Overlay Background Color",
        "type": "color",
        "default": "#2b2b2b"
      },
      {
        "id": "color",
        "label": "Text Color",
        "type": "color",
        "default": "#000418"
      },
      {
        "id": "logged_in_widget_id",
        "label": "Logged in yotpo widget id",
        "type": "text",
        "default": "1019844"
      }
    ],
    "presets": [
      {
        "name": "Rewards Hero | AW"
      }
    ]
  }
{% endschema %}
