{%- liquid
    assign padding_top = section.settings.padding_top | default: 0
    assign padding_bottom = section.settings.padding_bottom | default: 0
    assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
    assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

    assign media_type = section.settings.media_type | default: 'image'
    assign lazyload = section.settings.lazyload | default: false
    assign image = section.settings.image
    assign video = section.settings.video
    assign autoplay = section.settings.autoplay | default: false 
    assign show_big_play_button = section.settings.show_big_play_button | default: false
    assign play_control = section.settings.play_control | default: false 
    assign sound_control = section.settings.sound_control | default: false 
    assign content = section.settings.content
-%}

{%- render 'offset',
    id: section.id,
    padding_top: padding_top,
    padding_bottom: padding_bottom,
    padding_top_desktop: padding_top_desktop,
    padding_bottom_desktop: padding_bottom_desktop
-%}

{%- render 'adastra' with 'styles/sections/media-with-caption.scss' -%}

<section id="section-{{- section.id -}}">
    <div class="container">
        <div class="media-with-caption__media">
            {%- if media_type == 'image' -%}
                {%- if image -%}
                    {%- render 'img', image: image, loading: loading -%}
                {%- endif -%}
            {%- elsif media_type == 'video' -%}
                {%- if video -%}
                    {%- render 'video', 
                        video: video,
                        poster: image,
                        play_control: play_control,
                        show_big_play_button: show_big_play_button
                        sound_control: sound_control,
                        autoplay: autoplay
                    -%}
                {%- endif -%}
            {%- endif -%}
        </div>

        {%- if content != blank -%}
            <div class="media-with-caption__content rte rte--smaller superscript-normal">
                {{- content -}}
            </div>
        {%- endif -%}
    </div>
</section> 

{% schema %}
{
    "name": "Media with caption | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Settings"
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "Media type",
            "default": "video",
            "options": [
                { "value": "image", "label": "Image" },
                { "value": "video", "label": "Video" }
            ]
        },
        {
            "type": "checkbox",
            "id": "lazyload",
            "label": "Lazyload",
            "default": false,
            "info": "Enable if the media is below the fold."
        },
        {
            "type": "video",
            "id": "video",
            "label": "Video",
            "info": "Format: .mp4; Aspect ratio: 16 / 9"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Autoplay"
        },
        {
            "type": "checkbox",
            "id": "show_big_play_button",
            "label": "Show big play button",
            "info": "Works with autoplay disabled."
        },
        {
            "type": "checkbox",
            "id": "play_control",
            "label": "Play control",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "sound_control",
            "label": "Sound control",
            "default": true
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "With the video type, the image is used as a poster (first frame); Aspect ratio: 16 / 9"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
    ],
    "presets": [
        {
            "name": "Media with caption | AW"
        }
    ]
}
{% endschema %}
