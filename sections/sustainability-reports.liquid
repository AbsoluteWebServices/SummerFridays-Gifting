{%- if section.blocks.size > 0 -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign content = section.settings.content
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/sustaibability-reports.scss' -%}

    <section 
        id="section-{{- section.id -}}"
        x-data="sustainabilityReports"
        data-split-load-section
    >
        {%- if content != blank -%}
            <div class="container">
                <div class="rte sustaibability-reports__content">{{- content -}}</div>
            </div>
        {%- endif -%}

        <div 
            class="swiper sustaibability-reports__slider"
            x-ref="slider"
            x-intersect.once="initSlider"
        >
            <ul class="swiper-wrapper list-reset">
                {%- for block in section.blocks -%}
                    {%- liquid 
                        assign image = block.settings.image
                        assign report = block.settings.report
                        unless image or report != blank
                            continue
                        endunless

                        assign url = block.settings.url     
                    -%}

                    <li class="swiper-slide">
                        <div class="sustaibability-reports__report">
                            {%- if url != blank -%}
                                <a href="{{- url -}}" class="sustaibability-reports__image scale-img">
                            {%- else -%}
                                <div class="sustaibability-reports__image">
                            {%- endif -%}

                            <img 
                                src="{{- image | image_url: width: 700 -}}"
                                width="300"
                                height="300"
                                alt="{{- image.alt | default: 'Image gallery image' -}}"
                                class="absolute-img"
                                loading="lazy"
                            >

                            {%- if url != blank -%}
                                </a>
                            {%- else -%}
                                </div>
                            {%- endif -%}

                            <div class="sustaibability-reports__report-report">
                                {{- report -}}
                            </div>
                        </div>
                    </li>
                {%- endfor -%}
            </ul>

            <button
                class="swiper-nav-btn swiper-nav-btn--prev hover-opacity"
                type="button"
                aria-label="Go to the previous slide"
                data-swiper-prev
            >
                {%- render 'icon', name: 'swiper-chevron' -%}
            </button>

            <button
                class="swiper-nav-btn swiper-nav-btn--next hover-opacity"
                type="button"
                aria-label="Go to the next slide"
                data-swiper-next
            >
                {%- render 'icon', name: 'swiper-chevron' -%}
            </button>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
    "name": "Sustain. Reports | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Main Settings"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "info": "Hint: use Heading 2 for title, and paragraph for body"
        }
    ],
    "blocks": [
        {
            "name": "report",
            "type": "Report",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image",
                    "info": "Aspect ration: square."
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "URL"
                },
                {
                    "type": "liquid",
                    "id": "report",
                    "label": "Report"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Sustain. Reports | AW"
        }
    ]
}
{% endschema %}
