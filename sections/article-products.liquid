{%- assign products = article.metafields.accentuate.recommended_product -%}
{%- if products != blank -%}
  {%- liquid
      assign padding_top = section.settings.padding_top | default: 0
      assign padding_bottom = section.settings.padding_bottom | default: 0
      assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
      assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0
  
      assign content = section.settings.content
      assign layout = section.settings.layout | default: 'slider'
      assign content = section.settings.content 
  -%}
  
  {%- render 'offset',
      id: section.id,
      padding_top: padding_top,
      padding_bottom: padding_bottom,
      padding_top_desktop: padding_top_desktop,
      padding_bottom_desktop: padding_bottom_desktop
  -%}
  
  {%- render 'adastra' with 'styles/sections/pairs-well-with.scss' -%}
  
  <section 
      id="section-{{- section.id -}}"
      x-data="pairsWellWith"
      data-split-load-section
  >
      {%- if content != blank -%}
          <div class="container">
              <div class="pww__content-wrapper">
                  <div class="rte pww__content">
                      {{- content -}}
                  </div>
              </div>
          </div>
      {%- endif -%}
  
      <div
          class="swiper pww__slider pww__slider-{{- layout -}}"
          {% if layout == 'slider' %}
              x-ref="slider"
              x-intersect.once="initSlider"
          {% endif %}
      >
         <div 
              class="swiper-wrapper swiper-wrapper--main"
          >
              {%- for prod in products -%}
                  {%- assign product_obj = all_products[prod] -%}
                  {%- if product_obj != blank -%}
                    <div class="swiper-slide">
                        {%- render 'product-card', 
                            product: product_obj, 
                            lazyload: true,
                            disableLandscape: true,
                            top: true
                        -%}
                    </div>
                  {%- endif -%}
              {%- endfor -%}
          </div>
  
         <button
              class="swiper-nav-btn swiper-nav-btn--prev swiper-button-disabled hover-opacity"
              type="button"
              aria-label="Go to the previous slide"
              data-swiper-prev
          >
              {%- render 'icon', name: 'swiper-chevron' -%}
          </button>
  
          <button
              class="swiper-nav-btn swiper-nav-btn--next swiper-button-disabled hover-opacity"
              type="button"
              aria-label="Go to the next slide"
              data-swiper-next
          >
              {%- render 'icon', name: 'swiper-chevron' -%}
          </button>
      </div>
  </section>
{%- endif -%}

{% schema %}
    {
      "name": "Article products",
      "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Main Settings"
        },
        {
            "type": "select",
            "id": "layout",
            "label": "Layout",
            "default": "slider",
            "options": [
                { "value": "slider", "label": "Slider" },
                { "value": "grid", "label": "Grid" }
            ]
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "info": "Hint: use Heading 2 for title, and paragraph for body"
        }
      ],
      "enabled_on": {
        "templates": ["article"]
      },
      "presets": [
          {
            "name": "Article products"
          }
      ]
    }
  {% endschema %}