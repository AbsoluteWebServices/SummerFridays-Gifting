{%- if section.blocks.size == 3 -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

        assign content = section.settings.content | replace: 'Summer Fridays', '<span class="nowrap">Summer Fridays</span>'
        assign text_alignment = section.settings.text_alignment | default: 'center'
        assign font_size = section.settings.font_size | default: 'normal'
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/3-pillars.scss' -%}

    <section 
        id='section-{{- section.id -}}'
    >
        <div class='container container--3-pillars'>
            {%- if content != blank -%}
                <div class="rte {% if font_size == 'larger' %}p-large rte--larger{% endif %} three-pillars__content three-pillars__content--{{- text_alignment -}}"> 
                    {{- content -}}
                </div>
            {%- endif -%}

            <div class="three-pillars__items">
                {%- for block in section.blocks -%}
                    {%- liquid 
                        assign media_type = block.settings.media_type | default: 'image'
                        assign image = block.settings.image
                        assign video = block.settings.video
                        assign title = block.settings.title | escape | strip_html
                        assign subtitle = block.settings.subtitle | replace: 'Summer Fridays', '<span class="nowrap">Summer Fridays</span>'
                    -%}
                    <div class="three-pillars__item">
                        <div class="three-pillars__item-media">
                            {%- if media_type == 'image' -%}
                                {%- if image -%}
                                    {%- render 'img', image: image -%}
                                {%- endif -%}
                            {%- elsif media_type == 'video' -%}
                                {%- if video -%}
                                    {%- render 'video', 
                                        video: video,
                                        poster: image
                                    -%}
                                {%- endif -%}
                            {%- endif -%}
                        </div>

                        {%- if title != blank or subtitle != blank -%}
                            <div class="three-pillars__item-content">
                                {%- if title != blank -%}
                                    <p class="subheader-small three-pillars__item-title">{{- title -}}</p>
                                {%- endif -%}

                                {%- if subtitle != blank -%}
                                    <div class="rte three-pillars__item-subtitle p-large">{{- subtitle -}}</div>
                                {%- endif -%}
                            </div>
                        {%- endif -%}
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
    "name": "3 Pillars | AW",
    "max_blocks": 3,
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 3,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 6,
            "info": "1rem = 10px"
        },
        {
            "type": "header",
            "content": "Settings"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        },
        {
            "type": "select",
            "id": "text_alignment",
            "label": "Text alignment",
            "default": "center",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Center" },
                { "value": "right", "label": "Right" }
            ]
        },
        {
            "type": "select",
            "id": "font_size",
            "label": "Font size",
            "default": "normal",
            "options": [
                { "value": "normal", "label": "Normal" },
                { "value": "larger", "label": "Larger" }
            ]
        }
    ],
    "presets": [
        {
            "name": "3 Pillars | AW"
        }
    ],
    "blocks": [
        {
            "name": "Pillar",
            "type": "pillar",
            "settings": [
                {
                    "type": "select",
                    "id": "media_type",
                    "label": "Media type",
                    "default": "video",
                    "options": [
                        { "value": "image", "label": "Image" },
                        { "value": "video", "label": "Video" }
                    ]
                },
                {
                    "type": "video",
                    "id": "video",
                    "label": "Video",
                    "info": "Format: .mp4"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image",
                    "info": "With the video type, the image is used as a poster (first frame)"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "richtext",
                    "id": "subtitle",
                    "label": "Subtitle"
                }
            ]
        }
    ]
}
{% endschema %}
