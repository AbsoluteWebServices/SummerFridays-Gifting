{%- if section.blocks.size > 0 -%}
    {%- liquid
        assign padding_top = section.settings.padding_top | default: 0
        assign padding_bottom = section.settings.padding_bottom | default: 0
        assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
        assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0
    -%}

    {%- render 'offset',
        id: section.id,
        padding_top: padding_top,
        padding_bottom: padding_bottom,
        padding_top_desktop: padding_top_desktop,
        padding_bottom_desktop: padding_bottom_desktop
    -%}

    {%- render 'adastra' with 'styles/sections/small-banners.scss' -%}

    <section id="section-{{- section.id -}}">
        <div class="container container--blog">
            <div 
                class="small-banners"
            >
                {%- for block in section.blocks -%}
                    {%- liquid
                        assign media_type = block.settings.media_type | default: 'image'
                        assign video = block.settings.video
                        assign image = block.settings.image 
                        assign title = block.settings.title | escape | strip_html
                        assign content = block.settings.content
                        assign url = block.settings.url
                    -%}

                    <div class="small-banner">
                        {%- if url != blank -%}
                            <a href="{{- url -}}" class="small-banner__media scale-img" {% if title != blank %}aria-label="{{- title -}}"{% endif %}>
                        {%- else -%}
                            <div class="small-banner__media">
                        {%- endif -%}
                            {%- if media_type == 'image' -%}
                                {%- if image -%}
                                    {%- render 'img', image: image -%}
                                {%- endif -%}
                            {%- elsif media_type == 'video' -%}
                                {%- if video -%}
                                    {%- render 'video', 
                                        video: video,
                                        poster: image
                                    -%}
                                {%- endif -%}
                            {%- endif -%}
                        {%- if url != blank -%}
                            </a>
                        {%- else -%}
                            </div>
                        {%- endif -%}

                        {%- if title != blank or content != blank -%}
                            <div class="small-banner__body">
                                {%- if title != blank -%}
                                    {%- if url != blank -%}
                                        <a href="{{- url -}}" aria-label="{{- title -}}" class="cta-textlink hover-opacity">{{- title -}}</a>
                                    {%- else -%}
                                        <p class="cta-textlink">{{- title -}}</p>
                                    {%- endif -%}
                                {%- endif -%}

                                {%- if content != blank -%}
                                    <div class="small-banner__content rte rte--smaller">
                                        {{- content -}}
                                    </div>
                                {%- endif -%}
                            </div>
                        {%- endif -%}
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </section>
{%- endif -%}

{% schema %}
{
    "name": "Small Banners | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        }
    ],
    "blocks": [
        {
            "name": "Banner",
            "type": "banner",
            "settings": [
                {
                    "type": "select",
                    "id": "media_type",
                    "label": "Media type",
                    "default": "image",
                    "options": [
                        { "value": "image", "label": "Image" },
                        { "value": "video", "label": "Video" }
                    ]
                },
                {
                    "type": "video",
                    "id": "video",
                    "label": "Video",
                    "info": "Format: .mp4; Aspect ratio: 1 / 1"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image",
                    "info": "With the video type, the image is used as a poster (first frame); Aspect ratio: 1 / 1"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "richtext",
                    "id": "content",
                    "label": "Content"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "URL"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Small Banners | AW"
        }
    ]
}
{% endschema %}
