{%- liquid
    assign padding_top = section.settings.padding_top | default: 0
    assign padding_bottom = section.settings.padding_bottom | default: 0
    assign padding_top_desktop = section.settings.padding_top_desktop | default: 0
    assign padding_bottom_desktop = section.settings.padding_bottom_desktop | default: 0

	assign collection_handle = 'all-excluding-gift-cards'
	assign content = section.settings.content
	assign link_label = section.settings.link_label | escape | strip_html | strip
	assign link_url = section.settings.link_url
	assign you_might_like_label = section.settings.you_might_like_label | escape | strip_html | strip
	assign products = section.settings.products
-%}

{%- render 'offset',
    id: section.id,
    padding_top: padding_top,
    padding_bottom: padding_bottom,
    padding_top_desktop: padding_top_desktop,
    padding_bottom_desktop: padding_bottom_desktop
-%}

{%- render 'adastra' with 'styles/sections/search.scss' -%}

<section 
	x-data="search"
	data-split-load-section
	id="section-{{- section.id -}}" 
>
	<div class="container">
		<header class="search__header">
			<template
				x-if="($store.Search.searchResults?.products || []).length"
			>
				<h1>
					<span x-text="($store.Search.searchResults?.products || []).length">...</span> Result<span x-show="($store.Search.searchResults?.products || []).length !== 1">s</span> for "<span x-text="$store.Search.q ? $store.Search.q : '{{ search.terms | escape | strip_html | strip }}'">{{ search.terms | escape | strip_html | strip }}</span>"
				</h1>
			</template>

			<template
				x-if="!($store.Search.searchResults?.products || []).length"
			>
				<div>
					<h1>No results for "<span x-text="$store.Search.q ? $store.Search.q : '{{ search.terms | escape | strip_html | strip }}'">{{ search.terms | escape | strip_html | strip }}</span>"</h1>

					{%- if section.blocks.size > 0 -%}
						<div class="search__no-results-suggestions-wrapper">
							<p class="subheader-small">{{- 'general.search.suggestions' | t -}}</p>

							<ul class="search__no-results-suggestions list-reset">
								{%- for block in section.blocks -%}
									{%- liquid 
										assign suggestion = block.settings.title | escape | strip_html | strip
										if suggestion == blank
											continue
										endif
									-%}
									<li class="search__no-results-suggestion">
										{%- render 'icon', name: 'chevron-right' -%}
										{{- suggestion -}}
									</li>
								{%- endfor -%}
							</ul>
						</div>
					{%- endif -%}

					{%- if content != blank -%}
						<div class="search__no-results-content rte">
							{{- content -}}
						</div>
					{%- endif -%}

					{%- if link_label != blank and link_url != blank -%}
						<a 
							href="{{- link_url -}}"
							class="search__no-results-link cta-textlink cta-link-with-arrow cta-link-with-arrow--right"
							aria-label="{{- link_label -}}"
						>
							{{- link_label -}}
							{%- render 'icon', name: 'arrow-right' -%}
						</a>
					{%- endif -%}
				</div>
			</template>
		</header>
	</div>

	<template x-if="!($store.Search.searchResults?.products || []).length">
		<div class="search__you-might-like">
			{%- if you_might_like_label != blank -%}
				<div class="container">
					<p class="search__you-might-like-label subheader-small">{{- you_might_like_label -}}</p>
				</div>
			{%- endif -%}

			<div 
				x-intersect.once="initSliderYMAL"
				x-ref="sliderYMAL"
				class="swiper search__you-might-like-slider"
			>
				<div class="swiper-wrapper">
					{%- for product in products -%}
						<div class="swiper-slide">
							{%- render 'product-card', 
								product: product, 
								lazyload: true,
								disableLandscape: true,
								top: true
							-%}
						</div>
					{%- endfor -%}
				</div>

				<button
					class="swiper-nav-btn swiper-nav-btn--prev swiper-button-disabled hover-opacity"
					type="button"
					aria-label="Go to the previous slide"
					data-swiper-prev
				>
					{%- render 'icon', name: 'swiper-chevron' -%}
				</button>

				<button
					class="swiper-nav-btn swiper-nav-btn--next swiper-button-disabled hover-opacity"
					type="button"
					aria-label="Go to the next slide"
					data-swiper-next
				>
					{%- render 'icon', name: 'swiper-chevron' -%}
				</button>
			</div>
		</div>
	</template>

	<div class="search__products">
		{%- for i in (1..4) -%}
			<div data-search-card-placeholder>
				{%- render 'product-card-placeholder' -%}
			</div>
		{%- endfor -%}

		{%- paginate collections[collection_handle].products by 1000 -%}
			{%- for product in collections[collection_handle].products -%}
				{%- liquid
					assign lazyload = false
					if forloop.index > 4
						assign lazyload = true
					endif
				-%}

				<div
					x-show="($store.Search.searchResults?.products || []).map(product => Number(product.itemGroupId)).includes({{- product.id -}})"
					x-transition:enter="default-transition"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-1"
					x-transition:leave="default-transition"
					x-transition:leave-start="opacity-1"
					x-transition:leave-end="opacity-0"
					style="display: none;"
					:style="{
						order: ($store.Search.searchResults?.products || []).map(product => Number(product.itemGroupId)).findIndex(id => id === {{ product.id -}}) || 0
					}"
				>
					{%- render 'product-card', 
						product: product, 
						lazyload: lazyload
					-%}
				</div>
			{%- endfor -%}
		{%- endpaginate -%}
	</div>

	<template x-if="($store.Search.searchResults?.cms || []).length">
		<div class="search__related-posts">
			<div class="search__related-posts-header">
				<div class="container">
					<p class="subheader-large">{{- 'general.search.related_blog_posts' | t -}}</p>
				</div>
			</div>

			<div 
				x-ref="slider"
				class="swiper search__related-posts-slider"
				x-intersect.once="initSlider"
			>
				<div class="swiper-wrapper">
					<template
						x-for="(cms, index) in $store.Search.searchResults.cms"
                    	:key="`page-search-result-cms-${ index }`"
					>
						<div class="swiper-slide">
							<div class="predictive-search__cms">
								<div>
									<a
										:href="cms.url"
										class="predictive-search__cms-image scale-img"
										:aria-label="`Go to ${ cms.name }`"
									>
										<template x-if="cms.imageUrl">
											<img 
												:src="`${ cms.imageUrl }&width=280`" 
												:alt="cms.name"
												width="140"
												height="140"
												class="absolute-img"
											>
										</template>
									</a>

									<div>
										<a
											:href="cms.url"
											class="p-large hover-opacity"
											:aria-label="`Go to ${ cms.name }`"
											x-text="cms.name"
										></a>
									</div>

									<template x-if="cms.shortDesc">
										<p class="p-normal predictive-search__cms-description" x-text="`${ cms.shortDesc.trim().substring(0, 40) }${ cms.shortDesc.trim().length > 40 ? '...' : ''}`"></p>
									</template>
								</div>

								<div>
									<a
										:href="cms.url"
										class="cta-textlink cta-link-with-arrow cta-link-with-arrow--right"
										:aria-label="`Go to ${ cms.name }`"
									>
										{{- 'general.search.read_more' | t -}}
										{%- render 'icon', name: 'arrow-right' -%}
									</a>
								</div>
							</div>
						</div>
					</template>
				</div>

				<button
					class="swiper-nav-btn swiper-nav-btn--prev swiper-button-disabled hover-opacity"
					type="button"
					aria-label="Go to the previous slide"
					data-swiper-prev
				>
					{%- render 'icon', name: 'swiper-chevron' -%}
				</button>

				<button
					class="swiper-nav-btn swiper-nav-btn--next swiper-button-disabled hover-opacity"
					type="button"
					aria-label="Go to the next slide"
					data-swiper-next
				>
					{%- render 'icon', name: 'swiper-chevron' -%}
				</button>
			</div>
		</div>
	</template>

	<template x-if="($store.Search.searchResults?.suggestions || []).length">
		<div class="search__terms">
			<div class="container">
				<div class="search__related-posts-header">
					<p class="subheader-large">{{- 'general.search.related_searches' | t -}}</p>
				</div>

				<div class="search__suggestions a-underline-wrapper a-underline-style-2">
					<template
						x-for="(suggestion, index) in $store.Search.searchResults.suggestions"
						:key="`search-result-suggestion-${ index }`"
					>
						<div class="search__suggestion">
							<a :href="`/search?q=${suggestion.suggest.replaceAll('<b>', '').replaceAll('</b>', '')}`" class="p-normal" x-html="suggestion.suggest"></a>
						</div>
					</template>
				</div>
			</div>
		</div>
	</template>
</section>

{% schema %}
{
    "name": "Search | AW",
    "settings": [
        {
            "type": "header",
            "content": "Paddings"
        },
        {
            "type": "number",
            "id": "padding_top",
            "label": "Padding top (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom",
            "label": "Padding bottom (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_top_desktop",
            "label": "Padding top desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
        {
            "type": "number",
            "id": "padding_bottom_desktop",
            "label": "Padding bottom desktop (rem)",
            "default": 0,
            "info": "1rem = 10px"
        },
		{
			"type": "richtext",
			"id": "content",
			"label": "Still can't find... text"
		},
		{
			"type": "text",
			"id": "link_label",
			"label": "Link label"
		},
		{
			"type": "url",
			"id": "link_url",
			"label": "Link URL"
		},
		{
			"type": "text",
			"id": "you_might_like_label",
			"label": "You might like... label"
		},
		{
          "type": "product_list",
          "id": "products",
          "label": "You might like... products",
          "limit": 14
        }
    ],
	"blocks": [
        {
            "name": "Suggestion",
            "type": "suggestion",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Suggestion"
                }
            ]
        }
    ],
	"enabled_on": {
        "templates": ["search"]
    },
    "presets": [
        {
            "name": "Search | AW"
        }
    ]
}
{% endschema %}
