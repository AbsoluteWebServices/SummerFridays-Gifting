{% comment %}
  The data-label attributes on <td> elements are mobile-friendly
  helpers used for responsive-table labels
{% endcomment %}

<div class="account-order-tab">
  <h1 class="visually-hidden">
    {{ 'customer.account.title' | t }}
  </h1>

  {% comment %} <a href="/account" class="form__link">
    {{ 'customer.account.return' | t }}
  </a> {% endcomment %}

  <h2 class="form__title account-orders__name">
    {{ 'customer.order.title' | t: name: order.name }}
  </h2>
  {% if order.cancelled %}
    {%- assign cancelled_at = order.cancelled_at | date: "%b %d, %Y" -%}

    <div class="account-orders__cancel">
      <p>{{ 'customer.order.cancelled' | t: date: cancelled_at }}</p>
      <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason }}</p>
    </div>
  {% endif %}

  <div class="account-orders__grid">
    <div>
      <div class="account-orders__subtitle">{{ 'customer.orders.date' | t | upcase }}</div>
      <div class="account-orders__text">{{ order.created_at | date: "%b %d, %Y" }}</div>
    </div>

    <div>
      <div class="account-orders__subtitle">{{ 'customer.orders.payment_status' | t | upcase }}</div>
      <div class="account-orders__text">{{ order.financial_status_label }}</div>
    </div>

    <div>
      <div class="account-orders__subtitle">{{ 'customer.orders.fulfillment_status' | t | upcase }}</div>
      <div class="account-orders__text">{{ order.fulfillment_status_label }}</div>
    </div>

    <div>
      <div class="account-orders__subtitle">{{ 'customer.orders.total' | t | upcase }}</div>
      <div class="account-orders__text">{{ order.total_price | money }}</div>
    </div>
  </div>

  <section class="account-orders__detail">
    {% assign count = 0 %}

    {% for line_item in order.line_items %}
      {% assign count = count | plus: line_item.quantity %}
    {% endfor %}

    <div class="account-orders__items">
      {% for line_item in order.line_items %}
        <div class="account-orders__item"  id="{{ line_item.key }}">
          <div class="account-orders__image-container">
            <img src="{{ line_item.image | image_url }}" alt="{{ line_item.title | escape }}" class="account-orders__image">
          </div>

          <h3 class="account-orders__item-title">{{ line_item.title }}</h3>

          <div class="account-orders__item-price">
            {{ line_item.quantity | times: line_item.price | money }}{% if line_item.quantity > 1 %} (* {{ line_item.quantity }}){% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <div class="account-addresses">
    <div class="account-address account-address--billing">
      <h3 class="form__title subheader-large">
        {{ 'customer.order.billing_address' | t }}
      </h3>

      <p class="account-address__status">
        {{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}
      </p>

      {{ order.billing_address | format_address }}
    </div>

    <div class="account-address account-address--shipping">
      <h3 class="form__title subheader-large">
        {{ 'customer.order.shipping_address' | t }}
      </h3>

      <p class="account-address__status">
        {{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}
      </p>

      {{ order.shipping_address | format_address }}
    </div>
  </div>

  <div class="form__return">
    <a href="{{ routes.account_url }}" class="back-to-account hover-opacity" title="{{- 'customer.account.return' | t -}}">
      {% render 'icon', name: 'swiper-arrow-left' %}
      {{- 'customer.account.return' | t -}}
    </a>
  </div>
</div>
