{%- liquid
  assign padding_top = padding_top | default: 0 | append: 'rem'
  assign padding_bottom = padding_bottom | default: 0 | append: 'rem'
  assign padding_top_desktop = padding_top_desktop | default: 0 | append: 'rem'
  assign padding_bottom_desktop = padding_bottom_desktop | default: 0 | append: 'rem'
-%}

<style>
  #section-{{ id }} {
      padding-top: {{ padding_top }};
      padding-bottom: {{ padding_bottom }};
  }
  @media only screen and (min-width: 1280px) {
      #section-{{ id }} {
          padding-top: {{ padding_top_desktop }};
          padding-bottom: {{ padding_bottom_desktop }};
      }
  }
</style>