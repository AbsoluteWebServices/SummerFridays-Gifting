<div class="form form--reset-password">
  {% form 'reset_customer_password' %}
    <h1 class="form__title h2">
      {{ 'customer.reset_password.title' | t }}
    </h1>

    <p class="form__copy">
      {{ 'customer.reset_password.subtext' | t: email: email }}
    </p>

    {{ form.errors | default_errors }}

    <div class="form__group" data-form-password>
      <input type="password"
        autofocus
        name="customer[password]"
        id="ResetPassword"
        class="form__field form__field--password{% if form.errors contains 'password' %} input-error{% endif %}"
        placeholder="{{ 'customer.reset_password.password' | t }}"
        aria-label="{{ 'customer.reset_password.password' | t }}"
        required
        data-form-password-input
      >
    </div>

    <div class="form__group" data-form-password>
      <input type="password"
        name="customer[password_confirmation]"
        id="PasswordConfirmation"
        class="form__field form__field--password{% if form.errors contains 'password_confirmation' %} input-error{% endif %}"
        placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
        aria-label="{{ 'customer.reset_password.password_confirm' | t }}"
        required
        data-form-password-input
      >
    </div>

    <button class="form__button btn btn--chalk btn--full btn--center">
      {{ 'customer.recover_password.submit' | t }}
    </button>
  {% endform %}
</div>
