        --font-hero-title-line-height-mobile: {{- settings.font_hero_title_line_height_mobile | default: 45.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-hero-title-size-desktop: {{- settings.font_hero_title_size_desktop | default: 45.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-hero-title-line-height-desktop: {{- settings.font_hero_title_line_height_desktop | default: 52.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-pinyon-title-size-mobile: {{- settings.font_pinyon_title_size_mobile | default: 55.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-pinyon-title-line-height-mobile: {{- settings.font_pinyon_title_line_height_mobile | default: 55.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-pinyon-title-size-desktop: {{- settings.font_pinyon_title_size_desktop | default: 80.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-pinyon-title-line-height-desktop: {{- settings.font_pinyon_title_line_height_desktop | default: 86.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h3-size: {{- settings.font_h3_size | default: 18.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h3-line-height: {{- settings.font_h3_line_height | default: 23.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h4-size: {{- settings.font_h4_size | default: 14.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h4-line-height: {{- settings.font_h4_line_height | default: 17.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-cta-textlink-size: {{- settings.font_cta_textlink_size | default: 11.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-cta-textlink-line-height: {{- settings.font_cta_textlink_line_height | default: 16.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-p-small-size: {{- settings.font_p_small_size | default: 10.0 | divided_by: 10.0 | append: 'rem' -}};
