<style>
    :root {
        --font-primary: {% if settings.font_primary != blank %}{{ settings.font_primary }},{% endif %} sans-serif;
        --font-secondary: {% if settings.font_secondary != blank %}{{ settings.font_secondary }},{% endif %} sans-serif;
        --font-body: {% if settings.font_body != blank %}{{ settings.font_body }},{% endif %} sans-serif;
        --font-pinyon: "Pinyon Script", cursive, sans-serif;

        --font-body-size: {{- settings.font_body_size | default: 13.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-body-line-height: {{- settings.font_body_line_height | default: 18.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h1-size: {{- settings.font_h1_size | default: 30.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h1-line-height: {{- settings.font_h1_line_height | default: 36.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h1-larger-size-mobile: {{- settings.font_h1_larger_size_mobile | default: 38.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h1-larger-line-height-mobile: {{- settings.font_h1_larger_line_height_mobile | default: 45.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h1-larger-size-desktop: {{- settings.font_h1_larger_size_desktop | default: 45.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h1-larger-line-height-desktop: {{- settings.font_h1_larger_line_height_desktop | default: 52.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h2-larger-size-mobile: {{- settings.font_h2_larger_size_mobile | default: 38.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h2-larger-line-height-mobile: {{- settings.font_h2_larger_line_height_mobile | default: 45.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h2-larger-size-desktop: {{- settings.font_h2_larger_size_desktop | default: 45.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h2-larger-line-height-desktop: {{- settings.font_h2_larger_line_height_desktop | default: 52.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h2-size: {{- settings.font_h2_size | default: 26.0 | divided_by: 10.0 | append: 'rem' -}};
        --font-h2-line-height: {{- settings.font_h2_line_height | default: 30.0 | divided_by: 10.0 | append: 'rem' -}};
