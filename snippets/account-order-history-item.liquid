<div class="account-orders__entry">
  <div class="account-orders__name cta-textlink">{{ 'customer.orders.order_number' | t }} {{ order.name }}</div>
  <div class="account-orders__grid">
    <div>
      <div class="account-orders__subtitle cta-textlink">{{ 'customer.orders.date' | t | upcase }}</div>
      <div class="account-orders__text superscript-normal">{{ order.created_at | date: "%b %d, %Y" }}</div>
    </div>

    <div>
      <div class="account-orders__subtitle cta-textlink">{{ 'customer.orders.payment_status' | t | upcase }}</div>
      <div class="account-orders__text superscript-normal">{{ order.financial_status_label }}</div>
    </div>

    <div>
      <div class="account-orders__subtitle cta-textlink">{{ 'customer.orders.fulfillment_status' | t | upcase }}</div>
      <div class="account-orders__text superscript-normal">{{ order.fulfillment_status_label }}</div>
    </div>

    <div>
      <div class="account-orders__subtitle cta-textlink">{{ 'customer.orders.total' | t | upcase }}</div>
      <div class="account-orders__text superscript-normal">{{ order.total_price | money }}</div>
    </div>
  </div>

  {%- assign loop_limit = 4 -%}
  <div class="account-orders__items">
    {% for line_item in order.line_items limit: loop_limit %}
      {% if forloop.index != loop_limit %}
        <div class="account-orders__item">
          <div class="account-orders__image-container">
            <img 
              src="{{ line_item.image | image_url: width: 200 }}" 
              alt="{{ line_item.image.alt | default: line_item.title | escape }}" 
              class="absolute-img"
              width="100"
              height="100"
              loading="lazy"
            >
          </div>
        </div>
      {% else %}
        <div class="account-orders__item account-orders__item--limit">
          {% assign count = order.line_items.size | plus: 1 %}
          +{{ count | minus: loop_limit }}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="a-underline-wrapper a-underline-style-2">
    <a href="{{ order.customer_url }}" class="form__link p-small account-orders__cta">View Order</a>
  </div>
</div>
