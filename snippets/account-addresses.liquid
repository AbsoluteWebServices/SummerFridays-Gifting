<div
  class="account-addresses-tab"
  x-data="{ isNewAddressFormVisible: false }"
>
  {% paginate customer.addresses by 5 %}
    <h1 class="visually-hidden">
      {{ 'customer.account.title' | t }}
    </h1>

    {%- if customer.addresses.size == 0 -%}
      <p class="form__copy">
        You haven't saved any addresses yet.
      </p>
    {%- endif -%}

    <div class="account-address__items">
      {% for address in customer.addresses %}
        <div class="account-address__item" x-data="{ isEditAddressFormVisible: false }">
          <div class="account-address">
            <div class="form__copy account-address__location">
              {{ address | format_address }}
            </div>

            <input
              class="visually-hidden"
              type="checkbox"
              name="default_address"
              id="defaultAddress-{{ forloop.index }}"
              disabled
              {% if address == customer.default_address %}
                checked
              {% endif %}
            >
            <label for="defaultAddress-{{ forloop.index }}" class="checkbox-default p-small">
              Default Address
              {% render 'icon', name: 'checkmark' %}
            </label>

            <div class="form__actions">
              <button type="button" class="account-address__button account-address__button--edit address-edit-toggle p-small" @click="isEditAddressFormVisible = !isEditAddressFormVisible">
                {{ 'customer.addresses.edit' | t }}
              </button>

              <button type="button" class="account-address__button account-address__button--delete address-delete p-small"
                @click="if (confirm(`{{ 'customer.addresses.delete_confirm' | t }}`)) { Shopify.postLink('/account/addresses/{{ address.id }}', {parameters: {_method: 'delete'}}) }">
                {{ 'customer.addresses.delete' | t }}
              </button>
            </div>
          </div>

          <div id="EditAddress_{{ address.id }}" class="form account-address__form account-address__form--edit account-address__form--hidden" :class="{ 'account-address__form--hidden': !isEditAddressFormVisible }">
            {% form 'customer_address', address %}
              <h2 class="form__title">
                {{ 'customer.addresses.edit_address' | t }}
              </h2>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[first_name]"
                  id="AddressFirstName_{{ form.id }}"
                  value="{{ form.first_name }}"
                  autocapitalize="words"
                  placeholder="{{ 'customer.addresses.first_name' | t }}"
                  aria-label="{{ 'customer.addresses.first_name' | t }}"
                >
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[last_name]"
                  id="AddressLastName_{{ form.id }}"
                  value="{{ form.last_name }}"
                  autocapitalize="words"
                  placeholder="{{ 'customer.addresses.last_name' | t }}"
                  aria-label="{{ 'customer.addresses.last_name' | t }}"
                >
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[company]"
                  id="AddressCompany_{{ form.id }}"
                  value="{{ form.company }}"
                  autocapitalize="words"
                  placeholder="{{ 'customer.addresses.company' | t }}"
                  aria-label="{{ 'customer.addresses.company' | t }}"
                >
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[address1]"
                  id="AddressAddress1_{{ form.id }}"
                  value="{{ form.address1 }}"
                  autocapitalize="words"
                  placeholder="{{ 'customer.addresses.address1' | t }}"
                >
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[address2]"
                  id="AddressAddress2_{{ form.id }}"
                  value="{{ form.address2 }}"
                  autocapitalize="words"
                  placeholder="{{ 'customer.addresses.address2' | t }}"
                >
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[city]"
                  id="AddressCity_{{ form.id }}"
                  value="{{ form.city }}"
                  autocapitalize="words"
                  placeholder="{{ 'customer.addresses.city' | t }}"
                >
              </div>

              <div class="form__group">
                <select
                  name="address[country]"
                  id="AddressCountry_{{ form.id }}"
                  class="address-country-option"
                  data-form-id="{{ form.id }}"
                  data-default="{{ form.country }}"
                >
                  {{ country_option_tags }}
                </select>
              </div>

              <div class="form__group" id="AddressProvinceContainer_{{ form.id }}" style="display: none">
                <select
                  name="address[province]"
                  id="AddressProvince_{{ form.id }}"
                  data-default="{{ form.province }}"
                ></select>
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="text"
                  name="address[zip]"
                  id="AddressZip_{{ form.id }}"
                  value="{{ form.zip }}"
                  autocapitalize="characters"
                  placeholder="{{ 'customer.addresses.zip' | t }}"
                >
              </div>

              <div class="form__group">
                <input
                  class="form__field"
                  type="tel"
                  name="address[phone]"
                  id="AddressPhone_{{ form.id }}"
                  value="{{ form.phone }}"
                  pattern="[0-9\-]*"
                  placeholder="{{ 'customer.addresses.phone' | t }}"
                >
              </div>

              <div class="form__group form__group--checkbox">
                {{ form.set_as_default_checkbox }}

                <label for="address_default_address_{{ form.id }}" class="checkbox-default p-small{% if address == customer.default_address %} checkbox-disabled{% endif %}">
                  {{ 'customer.addresses.set_default' | t }}
                  {% render 'icon', name: 'checkmark' %}
                </label>
              </div>

              <div class="form__actions">
                <button class="form__button btn btn--chalk btn--center">
                  {{ 'customer.addresses.update' | t }}
                </button>

                <button type="button" class="form__link account-address__form-link address-edit-toggle" @click="isEditAddressFormVisible = false" data-form-id="{{ form.id }}">
                  {{ 'customer.addresses.cancel' | t }}
                </button>
              </div>
            {% endform %}
          </div>
        </div>
      {% endfor %}
    </div>

    <button type="button" class="form__button btn btn--chalk btn--center" @click="isNewAddressFormVisible = !isNewAddressFormVisible" data-account-address-new-toggle>
      {{ 'customer.addresses.add_new' | t }}
    </button>

    <div id="AddressNewForm" class="form account-address__form account-address__form--new account-address__form--hidden" :class="{ 'account-address__form--hidden': !isNewAddressFormVisible }">
      {% form 'customer_address', customer.new_address %}
        <h2 class="form__title">
          {{ 'customer.addresses.add_new' | t }}
        </h2>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[first_name]"
            id="AddressFirstNameNew"
            value="{{ form.first_name }}"
            autocapitalize="words"
            placeholder="{{ 'customer.addresses.first_name' | t }}"
          >
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[last_name]"
            id="AddressLastNameNew"
            value="{{ form.last_name }}"
            autocapitalize="words"
            placeholder="{{ 'customer.addresses.last_name' | t }}"
          >
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[company]"
            id="AddressCompanyNew"
            value="{{ form.company }}"
            autocapitalize="words"
            placeholder="{{ 'customer.addresses.company' | t }}"
          >
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[address1]"
            id="AddressAddress1New"
            value="{{ form.address1 }}"
            autocapitalize="words"
            placeholder="{{ 'customer.addresses.address1' | t }}"
          >
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[address2]"
            id="AddressAddress2New"
            value="{{ form.address2 }}"
            autocapitalize="words"
            placeholder="{{ 'customer.addresses.address2' | t }}"
          >
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[city]"
            id="AddressCityNew"
            value="{{ form.city }}"
            autocapitalize="words"
            placeholder="{{ 'customer.addresses.city' | t }}"
          >
        </div>

        <div class="form__group">
          <select
            name="address[country]"
            id="AddressCountryNew"
            data-default="{{ form.country }}"
          >
            {{ country_option_tags }}
          </select>
        </div>

        <div id="AddressProvinceContainerNew" class="form__group" style="display: none">
          <select
            name="address[province]"
            id="AddressProvinceNew"
            data-default="{{ form.province }}"
          ></select>
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="text"
            name="address[zip]"
            id="AddressZipNew"
            value="{{ form.zip }}"
            autocapitalize="characters"
            placeholder="{{ 'customer.addresses.zip' | t }}"
          >
        </div>

        <div class="form__group">
          <input
            class="form__field"
            type="tel"
            name="address[phone]"
            id="AddressPhoneNew"
            value="{{ form.phone }}"
            pattern="[0-9\-]*"
            placeholder="{{ 'customer.addresses.phone' | t }}"
          >
        </div>

        <div class="form__group form__group--checkbox">
          {{ form.set_as_default_checkbox }}

          <label for="address_default_address_new" class="checkbox-default p-small">
            {{ 'customer.addresses.set_default' | t }}
            {% render 'icon', name: 'checkmark' %}
          </label>
        </div>

        <div class="form__actions">
          <button class="form__button btn btn--chalk btn--center">
            {{ 'customer.addresses.add' | t }}
          </button>

          <button type="button" class="form__link account-address__form-link address-new-toggle" @click="isNewAddressFormVisible = false">
            {{ 'customer.addresses.cancel' | t }}
          </button>
        </div>
      {% endform %}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- include 'pagination' -%}
    {%- endif -%}
  {% endpaginate %}
</div>