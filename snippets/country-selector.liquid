{%- assign id = id | default: 'localization-form-desktop' -%}

<div 
    x-data="countrySelector"
    class="country-selector"
    data-split-load-section
    @click.outside="open = false"
>
    {%- form 'localization', id: id -%}
        <select class="visually-hidden" name="country_code" aria-label="Country switcher">
            {% for country in localization.available_countries %}
                <option
                    value="{{ country.iso_code }}"
                    {%- if country == localization.country %}
                        selected="selected"
                    {% endif %}
                >
                    {{ country.name }}
                </option>
            {% endfor %}
        </select>

        <button 
            class="country-selector__toggle hover-opacity"
            :class="open && 'is-open'"
            type="button"
            aria-controls="country-selector-dropwdown-{{ id }}"
            :aria-expanded="open"
            aria-label="Toggle countries dropdown"
            @click.prevent="open = ! open"
        >
            <div class="country-selector__toggle-inner">
                {%- liquid 
                    assign flag_name = localization.country.iso_code | append: '.png' 
                    assign flag = images[flag_name]
                -%}
                {%- if flag.src != blank -%}
                    <div class="country-selector__country-flag">
                        <img
                            src="{{- flag | image_url: width: 44 -}}"
                            alt="The flag of United States"
                            loading="eager"
                            width="18"
                            height="18"
                            class="absolute-img"
                            fetchpriority="high"
                        >
                    </div>

                    <span class="country-selector__country-iso-code">
                        {{- localization.country.name -}}
                    </span>
                {%- else -%}
                    {{- localization.country.iso_code -}}
                {%- endif -%}
            </div>

            {%- render 'icon', name: 'chevron-down' -%}
        </button>

        <ul
            id="country-selector-dropwdown-{{ id }}"
            class="country-selector__dropdown dropdown-content list-reset"
            :data-open="open"
            :style="open && { height: $el.scrollHeight + 'px' }"
            @resize.window="if (!open) { return; } $el.style.height = 'auto'"
        >
            <li>
                <button
                    class="country-selector__country {% if localization.country.iso_code == 'US' %}selected{% endif %}"
                    type="button"
                    @click.prevent="selectCountry('US')"
                >
                    {%- liquid 
                        assign flag_name = 'US.png'
                        assign flag = images[flag_name]
                    -%}
                    {%- if flag.src != blank -%}
                        <div class="country-selector__country-flag">
                            <img
                                src="{{- flag | image_url: width: 44 -}}"
                                alt="The flag of United States"
                                loading="lazy"
                                width="18"
                                height="18"
                                class="absolute-img"
                            >
                        </div>
                    {%- endif -%}

                    United States
                </button>
            </li>

            {%- for country in localization.available_countries -%}
                {%- unless country.iso_code == 'US' -%}
                    <li>
                        <button
                            class="country-selector__country {% if country == localization.country %}selected{% endif %}"
                            type="button"
                            @click.prevent="selectCountry('{{- country.iso_code -}}')"
                        >
                            {%- liquid
                                assign flag_name = country.iso_code | append: '.png'
                                assign flag = images[flag_name]
                            -%}
                            {%- if flag.src != blank -%}
                                <div class="country-selector__country-flag">
                                    <img
                                        src="{{- flag | image_url: width: 44 -}}"
                                        alt="The flag of {{ country.name }}"
                                        loading="lazy"
                                        width="18"
                                        height="18"
                                        class="absolute-img"
                                    >
                                </div>
                            {%- endif -%}

                            {{- country.name -}}
                        </button>
                    </li>
                {%- endunless -%}
            {%- endfor -%}
        </ul>
    {%- endform -%}
</div>