    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
    {% endif %}

    <title>{{ shop.name }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'social-meta-tags' %}

    {{ content_for_header }}

    <style>
      .template-password {
        color: #000000;
        display: table;
        font-family: "futura-pt";
        font-size: 16px;
        height: 100%;
        padding: 40px 20px;
        overflow: hidden;
        position: relative;
        text-align: center;
        width: 100%;
      }

      @media screen and (min-width: 768px) {
        .template-password {
          padding-bottom: 80px;
          padding-top: 80px;
        }
      }

      .template-password a {
        color: #666666;
        text-decoration: none;
      }

      .template-password a:hover {
        text-decoration: underline;
      }

      .template-password header {
        line-height: 1;
        margin-bottom: 20px;
      }

      .template-password header h1 {
        margin: 0;
      }

      .errors {
        color: #ed1c24;
        margin-bottom: 10px;
      }

      .template-password .site-logo-image {
        margin: 0 auto;
        max-width: 280px;
      }

      .template-password .social-sharing {
        display: none;
      }

      /* Login */
      .template-password #Login {
        margin: 0 auto;
        max-width: 280px;
      }

      .template-password #Login button {
        background: #000000;
        border: none;
        color: #ffffff;
        display: inline-block;
        font-family: "futura-pt-PT-Medium";
        font-size: 16px;
        line-height: 17px;
        max-width: 100%;
        overflow: visible;
        padding: 13px 23px;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        -webkit-transition: background-color 250ms;
        -o-transition: background-color 250ms;
        transition: background-color 250ms;
        white-space: nowrap;
        width: 100%;
      }

      @media screen and (min-width: 768px) {
        .template-password #Login button {
          padding: 17px 23px;
        }
      }

      .template-password #Login button:hover {
        background: #333333;
      }

      .template-password #Login h4 {
        font-weight: normal;
        margin: 0 0 20px;
      }

      .template-password #Login input[type="password"] {
        background: #ffffff;
        border: 1px solid #000000;
        color: #000000;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        height: 48px;
        line-height: 46px;
        margin-bottom: 10px;
        text-align: center;
        -webkit-appearance: none;
        width: 100%;
      }

      .template-password #Login input[type="password"]::-webkit-input-placeholder {
        color: #666666;
        font-family: "futura-pt";
        line-height: inherit;
        opacity: 1;
        overflow: visible;
        white-space: normal;
      }

      .template-password #Login input[type="password"]::-moz-placeholder {
        color: #666666;
        font-family: "futura-pt";
        line-height: inherit;
        opacity: 1;
        overflow: visible;
        white-space: normal;
      }

      .template-password #Login input[type="password"]:-ms-input-placeholder {
        color: #666666;
        font-family: "futura-pt";
        line-height: inherit;
        opacity: 1;
        overflow: visible;
        white-space: normal;
      }

      .template-password #Login input[type="password"]:-moz-placeholder {
        color: #666666;
        font-family: "futura-pt";
        line-height: inherit;
        opacity: 1;
        overflow: visible;
        white-space: normal;
      }

      .js .template-password #Login {
        height: 0;
        overflow: hidden;
        width: 0;
      }

      .js.login-active .template-password #Login {
        height: auto;
        overflow: visible;
        width: auto;
      }

      .template-password #Login label {
        display: none;
      }

      .template-password #Login p {
        font-size: 14px;
        margin-top: 25px;
      }

      /* MainContent */
      .template-password #MainContent > a {
        font-size: 0;
      }

      .template-password #MainContent > a:after {
        content: "Enter using password";
        font-size: 16px;
      }

      .template-password #MainContent > a svg {
        display: none;
      }

      .template-password #MainContent form {
        display: none;
      }

      .template-password #MainContent h2 {
        display: none;
      }

      .template-password #MainContent > p {
        display: none;
      }

      .js.login-active .template-password #MainContent {
        display: none;
      }

      /* Close */
      .template-password__close {
        background: transparent;
        border: 0;
        display: none;
        height: 20px;
        line-height: 20px;
        padding: 0;
        position: absolute;
        right: 20px;
        top: 20px;
        width: 20px;
        z-index: 10;
      }

      @media screen and (min-width: 768px) {
        .template-password__close {
          right: 40px;
          top: 40px;
        }
      }

      .template-password__close svg {
        height: 20px;
        width: 20px;
      }

      .login-active .template-password__close {
        display: block;
      }

      .template-password-inner {
        display: table-cell;
        text-align: center;
        vertical-align: middle;
      }
    </style>
  </head>

  <body class="template-password" data-theme="{{ theme.id }}">
    <button type="button" data-close class="template-password__close">
      {% render 'icon-close' %}
    </button>

    <div class="template-password-inner">
      <header role="banner">
        <h1 itemscope itemtype="http://schema.org/Organization">
          <div class="site-logo">
            <img src="{{ 'logo.svg' | asset_url }}" class="site-logo-image" alt="{{ shop.name }}" />
          </div>
        </h1>
      </header>

      <main role="main" id="MainContent">
        {{ content_for_layout }}
      </main>

      <div id="Login">
        <h4>{{ 'general.password_page.login_form_heading' | t }}</h4>
        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <label for="password">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input type="password"
            name="password"
            id="Password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            aria-label="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          >
          <button type="submit" name="commit">{{ 'general.password_page.login_form_submit' | t }}</button>
        {% endform %}
        <p>{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </div>

    <script src="{{ 'bundle.vendor.js' | asset_url }}"></script>

    <script>
      $(function () {
        var focusInput = function () {
          setTimeout(function () {
            $('#Password').focus();
          }, 100);
        };

        var addActive = function () {
          $('html').addClass('login-active');
        };

        var removeActive = function () {
          $('html').removeClass('login-active');
        };

        $(document).on('click', 'a[href="#Login"]', function () {
          addActive();
          focusInput();
        });

        $(document).on('click', '[data-close]', function () {
          removeActive();
          history.pushState('', document.title, window.location.pathname);
        });

        window.addEventListener('popstate', function () {
          var url = window.location.href;

          if (url.indexOf('#Login') === -1) {
            removeActive();
          } else {
            addActive();
          }
        }, false);

        if (window.location.hash) {
          var hash = window.location.hash;

          if (hash == '#Login') {
            addActive();
            focusInput();
          }
        }

        var errors = $('#Login .errors');
        if (errors && errors.length) {
          addActive();
          focusInput();
        }
      });
    </script>
  </body>
</html>
