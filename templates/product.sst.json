      "type": "2-blocks-with-accordions",
      "blocks": {
        "block_1_N4A4bY": {
          "type": "block_1",
          "settings": {
            "title": "Recycle with us and receive a $25 E-Gift Card",
            "content": "<p>Send back 5+ of your empty Summer Fridays products in exchange for a $25 e-gift card to be used on your next purchase on SummerFridays.com. Learn more <a href=\"https://summerfridays.com/pages/recycling-program\" target=\"_blank\" title=\"https://summerfridays.com/pages/recycling-program\">here.</a></p>",
            "html": "",
            "image": "shopify://shop_images/Jet-Lag-Mask-Empty_8df86097-7192-439b-9461-6691d9a503f0.jpg"
          }
        },
        "block_1_AccMec": {
          "type": "block_1",
          "settings": {
            "title": "Recycling Instructions",
            "content": "",
            "html": "<script src=\"https://app.bluebirdclimate.com/embed/summer-fridays?id=A52_QqNR_2XtSSEnAdwu-8pekgVh4DIrZQiHrRtgygWH_npzhylWF2ykXM0vSRPFyoFyWZUbeoq2VqHEOR_u1kY72mdyy5zHrehS0ar15v5TUFT-bgScQA\" async=\"\" type=\"text/javascript\"></script>"
          }
        },
        "block_1_cLM8Eh": {
          "type": "block_1",
          "settings": {
            "title": "Sustainability",
            "content": "<p>Learn more about sustainability <a href=\"/pages/sustainability\" title=\"Sustainability\">here</a>.</p>",
            "html": ""
          }
        },
        "block_2_BgUpiW": {
          "type": "block_2",
          "settings": {
            "title": "Is Sheer Skin Tint vegan and cruelty-free?",
            "content": "<p>Yes, Summer Fridays products are not tested on animals or contain any animal by-products.</p>",
            "html": ""
          }
        },
        "block_2_nA8DDL": {
          "type": "block_2",
          "settings": {
            "title": "Is Sheer Skin Tint gluten-free?",
            "content": "<p>Sheer Skin Tint is formulated without gluten. It’s important to note that while all Summer Fridays products are formulated to be gluten-free, we cannot guarantee that they have been produced in a gluten-free facility. However, The National Celiac Association has stated that unless cosmetic products are ingested, there should not be an issue with gluten in topical products.</p><p>Please see <a href=\"https://nationalceliac.org/celiac-disease-questions/using-gluten-free-skin-body-products-someone-celiac-disease/\">here</a> for additional information. As always, if there is concern, we recommend that you consult with your physician/healthcare provider prior to use.</p>",
            "html": ""
          }
        },
        "block_2_hCYxfB": {
          "type": "block_2",
          "settings": {
            "title": "Is Sheer Skin Tint non-comedogenic?",
            "content": "<p>Yes, Sheer Skin Tint is non-comedogenic, which means it will not clog pores.</p>",
            "html": ""
          }
        },
        "block_2_nR4nxm": {
          "type": "block_2",
          "settings": {
            "title": "Is Sheer Skin Tint suitable for all skin types?",
            "content": "<p>Yes, Sheer Skin Tint is suitable for all skin types, including sensitive skin.</p>",
            "html": ""
          }
        },
        "block_2_XwrpUn": {
          "type": "block_2",
          "settings": {
            "title": "Is Sheer Skin Tint fragrance-free?",
            "content": "<p>Yes, Sheer Skin Tint is formulated without fragrance.</p>",
            "html": ""
          }
        },
        "block_2_Qy6Bzc": {
          "type": "block_2",
          "settings": {
            "title": "Can I use Sheer Skin Tint every day?",
            "content": "<p>Yes, Sheer Skin Tint can be used everyday. We recommend applying after your morning skin care routine, directly following SPF.</p>",
            "html": ""
          }
        },
        "block_2_d3W6Fb": {
          "type": "block_2",
          "settings": {
            "title": "How do I know which shade of Sheer Skin Tint is best for me?",
            "content": "<p>We recommend using the Shade Finder on SummerFridays.com or on Sephora.com to determine the best shade for you.<br/>Sheer Skin Tint features “flexible” shades, meaning that they are forgiving and for many skin tones, it’s possible that more than one shade will work.</p>",
            "html": ""
          }
        },
        "block_2_DjY4Cw": {
          "type": "block_2",
          "settings": {
            "title": "Will Sheer Skin oxidize and change color once on my skin?",
            "content": "<p>Sheer Skin Tint should stay true to the shade that you see in the bottle.</p>",
            "html": ""
          }
        }
      },
