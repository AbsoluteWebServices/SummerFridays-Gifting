        "accordion_HTpFjb": {
          "type": "accordion",
          "settings": {
            "title": "How do I place a return or exchange?",
            "content": "<p>Summer Fridays will accept returns on any orders placed through our website within 30 days of purchase. Please see our <a href=\"/pages/returns-exchanges\" target=\"_blank\" title=\"Returns + Exchanges\"><span style=\"text-decoration:underline\">returns + exchanges</span></a> page for complete information. We are only able to accept returns for items purchased through <a href=\"http://www.summerfridays.com/\"><span style=\"text-decoration:underline\">www.summerfridays.com</span></a>. If you purchased a Summer Fridays item from one of our authorized retail partners, please follow that retailer’s return/exchange policy.</p>"
