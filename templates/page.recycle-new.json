    "media_accordions_jzVRkw": {
      "type": "media-accordions",
      "blocks": {
        "accordion_custom_FFe9YF": {
          "type": "accordion_custom",
          "settings": {
            "title": "What products are eligible for our recycling program?",
            "content": "<p>All Summer Fridays products are eligible for our recycling program with the exception of sample sizes (e.g. – deluxe sample tubes).</p><p>Our recycling program considers limited-edition sets as one full-sized product, so all empties from the set must be returned to be eligible.</p>",
            "badge": ""
          }
        },
        "accordion_custom_ifPAVd": {
          "type": "accordion_custom",
          "settings": {
            "title": "How do I prepare my products for recycling?",
            "content": "<p>Some of our products need to be rinsed prior to being submitted for recycling. Please refer to each specific product page for more information on how to prepare your Summer Fridays products for recycling.</p>",
            "badge": ""
          }
        },
        "accordion_custom_zTYYer": {
          "type": "accordion_custom",
          "settings": {
            "title": "Can I return more than 5 empties?",
            "content": "<p>Yes! While we require a minimum of 5 empties to qualify for the $25 e-gift card, feel free to send more than 5. Please note that we have a maximum e-gift card allotment of $25 per month for our recycling program.</p>",
            "badge": ""
          }
        },
        "accordion_custom_e8Nc74": {
          "type": "accordion_custom",
          "disabled": true,
          "settings": {
            "title": "Does the e-gift card have an expiration date?",
            "content": "",
            "badge": ""
          }
        },
        "accordion_custom_RPcXQz": {
          "type": "accordion_custom",
          "settings": {
            "title": "How long does it take to receive the e-gift card?",
            "content": "<p>Your e-gift card will be sent via email 5 business days after your empties have been delivered to us.</p><p>The recycling e-gift card does not expire and can be used towards your next purchase on SummerFridays.com.</p>",
            "badge": ""
          }
        },
        "accordion_custom_kRFg3p": {
          "type": "accordion_custom",
          "settings": {
            "title": "Are international customers eligible to participate?",
            "content": "<p>Our recycling program is only open to US customers currently.</p>",
            "badge": ""
          }
        },
        "accordion_custom_4UxYy6": {
          "type": "accordion_custom",
          "settings": {
            "title": "Can I only ship back empties purchased from SummerFridays.com?",
            "content": "<p>We are partnered with Pact Collective and happy to recycle additional empties from other brands. Feel free to include them with your Summer Fridays empties! However, these will not count towards your e-gift card.</p>",
            "badge": ""
          }
        },
        "accordion_custom_Bzkk7Y": {
          "type": "accordion_custom",
          "disabled": true,
          "settings": {
            "title": "Are return labels free?",
            "content": "",
            "badge": ""
          }
        },
        "accordion_custom_Q7TCiC": {
          "type": "accordion_custom",
