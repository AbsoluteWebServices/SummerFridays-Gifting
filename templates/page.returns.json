        "accordion_t49HeD": {
          "type": "accordion",
          "settings": {
            "title": "Can I return part of a set?",
            "content": "<p>We are not able to partially refund or credit a single item from a set or kit. All kits, gift sets and duos must be returned with all items in the kit in order to receive refund or credit. </p>"
