        "accordion_R6Gwje": {
          "type": "accordion",
          "settings": {
            "title": "How do I place a return?",
            "content": "<p>To return an item, click <a href=\"https://summerfridays.happyreturns.com/\">here</a> (note that by clicking on the link you agree to have your personal information relating to the order shared with our third-party vendor, Happy Returns, whose privacy policy is located here) and enter the email address that you used when you made your purchase along with your shipping zip code and click “Start Your Return”. Once you access the Return Portal, please choose which item you would like to return and select the reason for return.</p><p>Note: For returns from Canada, United Kingdom, Germany or France please reach out to our Customer Care team here, Monday through Friday, 7 a.m. to 4 p.m. PT to have a return label issued.</p>"
          }
        },
        "accordion_yKhzbK": {
          "type": "accordion",
          "settings": {
            "title": "How long does it take to process a return?",
            "content": "<p>Please allow 5–8 business days for your refund to process once your items have been received by our team. All refunds will be issued to the original payment method. </p><p>Please note: original shipping fees will not be refunded.</p>"
          }
        },
        "accordion_nrKneK": {
          "type": "accordion",
          "settings": {
            "title": "What should I do if I receive the wrong product?",
            "content": "<p>Please contact our Customer Care Team <a href=\"https://help.summerfridays.com/hc/en-us/requests/new\"><span style=\"text-decoration:underline\">here</span></a> and we’d be happy to exchange, refund or help you order the correct product.</p>"
          }
        },
        "accordion_Jtgfwp": {
          "type": "accordion",
          "settings": {
            "title": "What should I do if I receive a damaged product?",
            "content": "<p>Please contact our Customer Care Team <a href=\"https://help.summerfridays.com/hc/en-us/requests/new\"><span style=\"text-decoration:underline\">here</span></a> along with an image of your damage to be reviewed by our team.</p>"
