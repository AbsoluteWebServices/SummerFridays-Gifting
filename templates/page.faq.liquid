{% assign meta = page.metafields.accentuate %}
{% assign title = meta.page_hero_title | default: page.title %}

<div class="page">
  {% render 'page-hero',
    image: meta.page_hero_image_desktop[0].src,
    image_mobile: meta.page_hero_image_mobile[0].src,
    ns: 'page-hero',
    tag: 'h1',
    title: title,
  %}

  {% section 'faq' %}
</div>
