{%- liquid
  render 'adastra' with 'styles/sections/account/reset-password.scss'
-%}
{% assign image_alt = settings.account_image.alt | default: "Account Image" %}

{%- capture account_image -%}
  {%- if settings.account_image_activate != blank -%}
    {{ settings.account_image_activate | image_url }}
  {%- elsif settings.account_image != blank -%}
    {{ settings.account_image | image_url }}
  {%- endif -%}
{%- endcapture -%}

<div class="reset-password-wrapper">
  <div class="container container--smaller-tablet container--padding-tablet">
    <div class="two-cols-wrapper">
      {%- if account_image != blank -%}
        <div class="media-col">
          <img class="main-image" src="{{ account_image }}" alt="{{ image_alt }}" />
        </div>
      {%- endif -%}

      <div class="content-col">
        {%- render 'account-activate' -%}
      </div>
    </div>
  </div>
</div>
